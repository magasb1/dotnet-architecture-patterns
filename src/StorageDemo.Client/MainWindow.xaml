<Window x:Class="StorageDemo.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        Title="Storage Demo Explorer"
        Height="820"
        Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="TileLayout">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- One key and its value. Shared by the metadata panel and the KLV panel below it. -->
        <DataTemplate x:Key="MetadataRowTemplate">
            <StackPanel Width="290" Margin="0,0,16,5">
                <TextBlock Text="{Binding Key}"
                           FontSize="10"
                           Foreground="#888" />
                <TextBlock Text="{Binding Value}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Value}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate">
            <StackPanel Width="112" Margin="6" Opacity="{Binding Dimming}">
                <Border Height="86"
                        Background="#F2F2F2"
                        BorderBrush="#DDD"
                        BorderThickness="1">
                    <Grid>
                        <!-- One JPEG rendered by the server, for photos and videos alike. -->
                        <Image Source="{Binding Thumbnail}"
                               Visibility="{Binding ThumbnailVisibility}"
                               Stretch="Uniform"
                               Margin="3" />
                        <TextBlock Text="{Binding Icon}"
                                   Visibility="{Binding IconVisibility}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#777"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Border Visibility="{Binding LiveBadgeVisibility}"
                                Background="#CC0000"
                                CornerRadius="2"
                                Padding="4,1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="4">
                            <TextBlock Text="LIVE"
                                       Foreground="White"
                                       FontSize="9"
                                       FontWeight="Bold" />
                        </Border>
                        <Border Visibility="{Binding PlayBadgeVisibility}"
                                Background="#99000000"
                                Width="30"
                                Height="30"
                                CornerRadius="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#x25B6;"
                                       Foreground="White"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="3,0,0,0" />
                        </Border>

                        <!--
                            The marking and the transport's health, at the foot of the picture.
                            A stream with no security set reads UNMARKED rather than nothing, and
                            the bar is colour and position only: its figures are in its tooltip.
                        -->
                        <StackPanel VerticalAlignment="Bottom" ToolTip="{Binding HealthTooltip}">
                            <Border Visibility="{Binding MarkingVisibility}"
                                    Background="{Binding MarkingBrush}"
                                    Padding="3,1">
                                <TextBlock Text="{Binding Marking}"
                                           ToolTip="{Binding Marking}"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Visibility="{Binding HealthVisibility}"
                                    Background="{Binding HealthBrush}"
                                    Height="3" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           Margin="0,4,0,0"
                           ToolTip="{Binding FileName}" />
                <TextBlock Text="{Binding Details}"
                           FontSize="10"
                           Foreground="#777"
                           TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <TextBlock Text="Server" VerticalAlignment="Center" Margin="4,0,6,0" />
            <ComboBox x:Name="ServerBox"
                      Width="300"
                      IsEditable="True"
                      KeyDown="OnServerKeyDown"
                      SelectionChanged="OnServerSelected"
                      ToolTip="Pick a saved endpoint or type any address, then Connect." />
            <TextBlock Text="Token" VerticalAlignment="Center" Margin="8,0,6,0" />
            <!-- Only the live calls are guarded, and only when the server was given a token. -->
            <TextBox x:Name="TokenBox"
                     Width="130"
                     KeyDown="OnServerKeyDown"
                     Padding="4,3"
                     ToolTip="The server's Live__Token, sent with the live calls. Leave empty when the server has none." />
            <Button x:Name="ConnectButton" Click="OnConnect" Padding="10,3">Connect</Button>
            <Separator />
            <Button x:Name="UploadButton" Click="OnUpload" Padding="10,3">Upload</Button>
            <Button x:Name="RefreshButton" Click="OnRefresh" Padding="10,3">Refresh</Button>
            <Separator />
            <Button x:Name="OpenExternallyButton" Click="OnOpenExternally" Padding="10,3">Open externally</Button>
            <Button x:Name="SaveAsButton" Click="OnSaveAs" Padding="10,3">Save as</Button>
            <Separator />
            <Button x:Name="DeleteButton" Click="OnDelete" Padding="10,3">Delete</Button>
            <Separator />
            <!--
                Both act on the server and keep running without this client. Closing the window
                does not stop a recording, which is the whole reason they are server-side.
            -->
            <Button x:Name="RecordButton" Click="OnRecord" Padding="10,3"
                    ToolTip="Record this stream. It starts a few seconds before now and keeps running if this window closes.">Record</Button>
            <Button x:Name="SnapshotButton" Click="OnSnapshot" Padding="10,3"
                    ToolTip="Store a full-resolution picture of this stream as a document.">Snapshot</Button>
            <!--
                Detection is the server's state, like a recording: it survives this window closing.
                The rate is detections per second; the tracker runs at frame rate between them.
            -->
            <Button x:Name="DetectButton" Click="OnDetect" Padding="10,3"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="Ask a worker to run object detection on this stream.">Detect</Button>
            <ComboBox x:Name="DetectRateBox"
                      Width="52"
                      SelectedIndex="1"
                      ToolTip="Detections per second">
                <ComboBoxItem>1/s</ComboBoxItem>
                <ComboBoxItem>5/s</ComboBoxItem>
                <ComboBoxItem>25/s</ComboBoxItem>
            </ComboBox>
            <Separator />
            <!-- Remembered across restarts: a demo audience wants the clean picture too. -->
            <CheckBox x:Name="HudToggle"
                      VerticalAlignment="Center"
                      Margin="4,0"
                      Checked="OnHudToggled"
                      Unchecked="OnHudToggled"
                      ToolTip="Draw the sensor metadata over the picture while the stream carries KLV.">HUD</CheckBox>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Connecting..." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ProviderText" Foreground="#555" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                Two lists, never mixed. A stream is something happening now that disappears when it
                stops; a document is a file that stays. Sorting, filtering and the actions that
                apply differ enough that one list showing both was always going to be a compromise.

                Streams first, because that is the tab worth looking at when something is on air.
            -->
            <TabControl Grid.Column="0" x:Name="SidebarTabs" SelectionChanged="OnTabChanged">
                <TabItem Header="Streams">
                    <Grid>
                        <ListBox x:Name="StreamList"
                                 SelectionChanged="OnSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 BorderThickness="0"
                                 ItemsPanel="{StaticResource TileLayout}"
                                 ItemTemplate="{StaticResource TileTemplate}" />

                        <!-- Collapsed the moment anything is live, so the tab is never just empty. -->
                        <TextBlock x:Name="NoStreamsHint"
                                   Text="Nothing is streaming."
                                   Foreground="#999"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </TabItem>

                <TabItem x:Name="DocumentsTab" Header="Documents">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="#FAFAFA"
                                BorderBrush="#DDD"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <StackPanel>
                                <TextBox x:Name="SearchBox"
                                         TextChanged="OnFilterChanged"
                                         ToolTip="Filter by file name"
                                         Padding="4,3" />
                                <TextBlock Text="Search by name"
                                           FontSize="10"
                                           Foreground="#999"
                                           Margin="2,2,0,6"
                                           IsHitTestVisible="False" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="TypeFilter"
                                              Width="104"
                                              SelectedIndex="0"
                                              SelectionChanged="OnFilterChanged">
                                        <ComboBoxItem>All types</ComboBoxItem>
                                        <ComboBoxItem>Images</ComboBoxItem>
                                        <ComboBoxItem>Video</ComboBoxItem>
                                        <ComboBoxItem>Audio</ComboBoxItem>
                                        <ComboBoxItem>Text</ComboBoxItem>
                                        <ComboBoxItem>PDF</ComboBoxItem>
                                        <ComboBoxItem>Other</ComboBoxItem>
                                    </ComboBox>

                                    <TextBlock Text="Added" VerticalAlignment="Center" Margin="10,0,6,0" />
                                    <ComboBox x:Name="DateFilter"
                                              Width="104"
                                              SelectedIndex="0"
                                              SelectionChanged="OnFilterChanged">
                                        <ComboBoxItem>Any time</ComboBoxItem>
                                        <ComboBoxItem>Today</ComboBoxItem>
                                        <ComboBoxItem>Last 7 days</ComboBoxItem>
                                        <ComboBoxItem>Last 30 days</ComboBoxItem>
                                    </ComboBox>

                                    <Button Click="OnClearFilters"
                                            Padding="8,2"
                                            Margin="10,0,0,0"
                                            ToolTip="Clear the search and both filters">Clear</Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="DocumentList"
                                 SelectionChanged="OnSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 BorderThickness="0"
                                 ItemsPanel="{StaticResource TileLayout}"
                                 ItemTemplate="{StaticResource TileTemplate}" />
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEE" />

            <Grid Grid.Column="2" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PreviewTitle"
                           Grid.Row="0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Text="Select a document" />

                <Grid Grid.Row="1" MinHeight="220">
                    <Image x:Name="ImagePreview" Visibility="Collapsed" Stretch="Uniform" />

                    <!-- FlyleafLib renders through Direct3D and decodes with the bundled libav. -->
                    <fl:FlyleafHost x:Name="PlayerHost"
                                    Visibility="Collapsed"
                                    Background="Black"
                                    VideoBackground="Black"
                                    ToggleFullScreenOnDoubleClick="Both"
                                    KeyBindings="Both">
                        <!--
                            The host's content is its Overlay window, which is the only place a
                            banner is actually over the video: the picture is drawn in a separate
                            Surface window, and both of them go fullscreen together. Anything drawn
                            beside the host in this window would be left behind the moment it did.
                        -->
                        <Grid IsHitTestVisible="False">
                            <!--
                                Detection boxes, in the same overlay for the same reason. Positioned
                                from code, because the picture's rectangle inside the host is the
                                renderer's to report, not the layout's.
                            -->
                            <Canvas x:Name="DetectionCanvas"
                                    SizeChanged="OnDetectionCanvasSizeChanged"
                                    ClipToBounds="True" />

                            <!--
                                The heads-up display, in the same overlay for the same reason,
                                and inside the picture rather than inside the host: the margin is
                                set from code to the rectangle the renderer painted the video in,
                                so the corner blocks sit on the imagery and not on the letterbox,
                                and the centre of this grid is the centre of the frame.

                                Everything here is one TextBlock per corner, monospaced, so the
                                columns line up without a layout for each field. Drawn under the
                                marking banner and never over it.
                            -->
                            <Grid x:Name="HudLayer" Visibility="Collapsed">
                                <Grid.Resources>
                                    <!--
                                        A black glow rather than a panel behind the text: it keeps
                                        white text readable over snow and over shadow without
                                        putting a grey box over the imagery.
                                    -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="#F2F2F2" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>

                                <!-- 28 down the picture, which clears the marking banner across the top of the host. -->
                                <StackPanel HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="10,28,0,0"
                                            RenderTransformOrigin="0,0">
                                    <StackPanel.RenderTransform>
                                        <ScaleTransform x:Name="HudTopLeftScale" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock x:Name="HudTopLeft" />
                                    <TextBlock x:Name="HudStale" Visibility="Collapsed" Foreground="#FBBF24" />
                                </StackPanel>

                                <TextBlock x:Name="HudTopRight"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           TextAlignment="Right"
                                           Margin="0,28,10,0"
                                           RenderTransformOrigin="1,0">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="HudTopRightScale" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <TextBlock x:Name="HudBottomLeft"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           Margin="10,0,0,10"
                                           RenderTransformOrigin="0,1">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="HudBottomLeftScale" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Keep the reticle sized and centred independently of the caption. In a shared
                                     auto-sized wrapper, Path stretches to the caption's much larger layout slot. -->
                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="HudCentreScale" />
                                    </Grid.RenderTransform>
                                    <Path Data="M 0,22 H 14 M 30,22 H 44 M 22,0 V 14 M 22,30 V 44"
                                          Stroke="#F2F2F2"
                                          StrokeThickness="1"
                                          Width="44"
                                          Height="44"
                                          Stretch="None"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Effect>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1" />
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock x:Name="HudCentre"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform Y="50" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>

                                <!-- Right edge, vertically centred: the owner's placement. It sits clear of the
                                     classification banner at the top, the corner blocks, and the reticle in the
                                     middle of the picture. -->
                                <StackPanel HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0"
                                            RenderTransformOrigin="1,0.5">
                                    <StackPanel.RenderTransform>
                                        <ScaleTransform x:Name="HudNorthScale" />
                                    </StackPanel.RenderTransform>
                                    <Grid x:Name="HudNorthArrow"
                                          Width="40"
                                          Height="58"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="HudNorthRotate" />
                                        </Grid.RenderTransform>
                                        <Canvas Width="40" Height="58">
                                            <!-- A light instrument needle: open head, slim shaft and a centre
                                                 break reserved for the label instead of a bulky filled glyph. -->
                                            <Path Data="M 20,54 V 36 M 20,22 V 7 M 11,17 L 20,7 L 29,17"
                                                  Stroke="#FFF2F2F2"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round">
                                                <Path.Effect>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="1" />
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                        <!-- The arrow rotates; its centre label remains readable. -->
                                        <TextBlock Text="N"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#FFF2F2F2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="HudNorthLabelRotate" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock x:Name="HudNorthText"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border x:Name="MarkingBanner"
                                    Visibility="{Binding MarkingVisibility, FallbackValue=Collapsed}"
                                    Background="{Binding MarkingBrush}"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Stretch"
                                    Padding="6,3">
                                <TextBlock Text="{Binding Marking}"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                    </fl:FlyleafHost>

                    <TextBox x:Name="TextPreview"
                             Visibility="Collapsed"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />

                    <StackPanel x:Name="FallbackPreview"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="FallbackText"
                                   TextAlignment="Center"
                                   Foreground="#666"
                                   Margin="0,0,0,10" />
                        <Button Click="OnOpenExternally" Padding="14,5">Open in the system viewer</Button>
                    </StackPanel>
                </Grid>

                <!-- Transport controls: scrub, play, skip, volume, speed, fullscreen. -->
                <Border x:Name="PlayerControls"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Background="#F7F7F7"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        Padding="8,6"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="PositionText"
                                       Grid.Column="0"
                                       Text="0:00"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       FontFamily="Consolas" />

                            <!-- IsMoveToPointEnabled makes a click jump straight to that position. -->
                            <Slider x:Name="PositionSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1000"
                                    IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    PreviewMouseLeftButtonDown="OnSeekStarted"
                                    PreviewMouseLeftButtonUp="OnSeekFinished"
                                    ValueChanged="OnSeekValueChanged" />

                            <TextBlock x:Name="DurationText"
                                       Grid.Column="2"
                                       Text="0:00"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       FontFamily="Consolas" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="PlayPauseButton" Click="OnPlayPause" Width="76" Padding="6,3">Pause</Button>
                            <Button Click="OnSkipBack" Padding="8,3" Margin="6,0,0,0" ToolTip="Back 10 seconds">&#x25C0;&#x25C0; 10s</Button>
                            <Button Click="OnSkipForward" Padding="8,3" Margin="6,0,0,0" ToolTip="Forward 10 seconds">10s &#x25B6;&#x25B6;</Button>
                            <Button Click="OnStop" Padding="8,3" Margin="6,0,0,0">Stop</Button>

                            <Separator Margin="10,0" />

                            <Button x:Name="MuteButton" Click="OnToggleMute" Width="62" Padding="6,3">Mute</Button>
                            <Slider x:Name="VolumeSlider"
                                    Width="110"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="70"
                                    IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                    ValueChanged="OnVolumeChanged" />

                            <Separator Margin="10,0" />

                            <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="SpeedBox"
                                      Width="72"
                                      SelectedIndex="2"
                                      SelectionChanged="OnSpeedChanged">
                                <ComboBoxItem>0.25x</ComboBoxItem>
                                <ComboBoxItem>0.5x</ComboBoxItem>
                                <ComboBoxItem>1x</ComboBoxItem>
                                <ComboBoxItem>1.5x</ComboBoxItem>
                                <ComboBoxItem>2x</ComboBoxItem>
                            </ComboBox>

                            <Button Click="OnToggleFullScreen"
                                    Padding="8,3"
                                    Margin="10,0,0,0"
                                    ToolTip="Double-click the video, or press F">Fullscreen</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Everything the server's probe read, listed under the image or video. -->
                <Border x:Name="MetadataPanel"
                        Grid.Row="3"
                        Visibility="Collapsed"
                        BorderBrush="#DDD"
                        BorderThickness="0,1,0,0"
                        Margin="0,10,0,0"
                        Padding="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Metadata"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <ScrollViewer Height="190" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="MetadataList"
                                          ItemsPanel="{StaticResource TileLayout}"
                                          ItemTemplate="{StaticResource MetadataRowTemplate}" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!--
                    The MISB ST 0902 set from the newest KLV packet, as text, for the stream being
                    watched. Polled only while one is playing, and absent altogether for a stream
                    the listing says carries no KLV.
                -->
                <Border x:Name="KlvPanel"
                        Grid.Row="4"
                        Visibility="Collapsed"
                        BorderBrush="#DDD"
                        BorderThickness="0,1,0,0"
                        Margin="0,10,0,0"
                        Padding="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Sensor (MISB ST 0902)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="KlvList"
                                          ItemsPanel="{StaticResource TileLayout}"
                                          ItemTemplate="{StaticResource MetadataRowTemplate}" />
                        </ScrollViewer>
                        <TextBlock x:Name="KlvHint"
                                   Height="16"
                                   Visibility="Hidden"
                                   Foreground="#999"
                                   FontSize="11" />
                    </StackPanel>
                </Border>

                <!--
                    The newest VMTI frame for the stream being watched, while detection is on for
                    it. The age is the honest part: the boxes over the picture are as old as this
                    says, not as new as the picture.
                -->
                <Border x:Name="DetectionPanel"
                        Grid.Row="5"
                        Visibility="Collapsed"
                        BorderBrush="#DDD"
                        BorderThickness="0,1,0,0"
                        Margin="0,10,0,0"
                        Padding="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Detections (MISB ST 0903)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="DetectionSummary"
                                   Foreground="#999"
                                   FontSize="11"
                                   Margin="0,0,0,6" />
                        <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DetectionList"
                                          ItemsPanel="{StaticResource TileLayout}"
                                          ItemTemplate="{StaticResource MetadataRowTemplate}" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
