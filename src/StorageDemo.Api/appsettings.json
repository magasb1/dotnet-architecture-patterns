{
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:5080",
        "Protocols": "Http2"
      }
    }
  },
  "Storage": {
    "Provider": "FileSystem",
    "FileSystem": {
      "RootPath": "./data/files"
    },
    "S3": {
      "Bucket": "storage-demo",
      "Region": "eu-north-1",
      "ServiceUrl": null,
      "ForcePathStyle": false
    }
  },
  "Database": {
    "Provider": "LiteDb",
    "LiteDb": {
      "Path": "./data/database/app.db"
    },
    "Postgres": {
      "ConnectionString": ""
    }
  },
  "Uploads": {
    "MaxBytes": 52428800
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Provider": "InMemory",
    "Redis": {
      "ConnectionString": "",
      "Channel": "storagedemo:changes"
    }
  },
  "StorageMonitor": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "Prefix": "documents/",
    "DebounceMilliseconds": 1000,
    "WebhookToken": ""
  },
  "Media": {
    "Enabled": true,
    "LibraryPath": "",
    "ThumbnailSize": 320,
    "ThumbnailQuality": 4,
    "VideoFrameSeconds": 3
  },
  "Live": {
    "Enabled": false,
    "Token": "",
    "AllowedSchemes": [
      "udp",
      "rtp",
      "srt"
    ],
    "PublicBaseUrl": "http://127.0.0.1:8080",
    "PeerAddressTemplate": "",
    "ThumbnailIntervalSeconds": 5
  }
}
