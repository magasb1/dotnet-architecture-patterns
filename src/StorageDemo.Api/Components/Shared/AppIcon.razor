<svg class="@Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
            break;
        case "copy":
            <rect x="8" y="8" width="11" height="11" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
            break;
        case "check":
            <path d="m5 12 4 4L19 6" />
            break;
        case "edit":
            <path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
            break;
        case "trash":
            <path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7M10 11v5M14 11v5" />
            break;
        case "refresh":
            <path d="M20 6v5h-5M4 18v-5h5" /><path d="M18.5 9A7 7 0 0 0 6 6.5L4 9m2 6a7 7 0 0 0 12 2.5L20 15" />
            break;
        case "chevron":
            <path d="m9 18 6-6-6-6" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "external":
            <path d="M14 4h6v6M20 4 10 14" /><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" />
            break;
        case "broadcast":
            <circle cx="12" cy="12" r="2" /><path d="M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7M5.5 5.5a9 9 0 0 0 0 13M18.5 5.5a9 9 0 0 1 0 13" />
            break;
        case "alert":
            <path d="M12 3 2.5 20h19ZM12 9v4M12 17h.01" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string? Class { get; set; }
}
