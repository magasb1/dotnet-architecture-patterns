@inject IStreamConfigurationService ConfigurationService

<div class="details-panel">
    <section class="detail-card">
        <header>
            <div><span class="overline">Local output</span><strong>Player connection</strong></div>
            <StatusBadge Text="@StateText(Row.State)" Tone="@StateTone(Row.State)" />
        </header>
        <dl>
            <div class="url-row"><dt>URL</dt><dd class="mono" title="@Row.LocalOutput">@Row.LocalOutput</dd></div>
            <div><dt>Transferred</dt><dd class="mono">@(Row.Stream is null ? "—" : FormatSize(Row.Stream.Bytes))</dd></div>
            <div><dt>Viewers</dt><dd class="mono">@(Row.Stream is null ? "—" : Row.Stream.Viewers.ToString("N0", CultureInfo.InvariantCulture))</dd></div>
            @if (Row.Stream?.Link is { } link)
            {
                <div><dt>Bandwidth</dt><dd class="mono">@FormatMbps(link.BandwidthMbps)</dd></div>
                <div><dt>Receive rate</dt><dd class="mono">@FormatMbps(link.ReceiveRateMbps)</dd></div>
                <div><dt>Round trip</dt><dd class="mono">@link.RoundTripTimeMs.ToString("0", CultureInfo.InvariantCulture) ms</dd></div>
                <div><dt>Retransmitted</dt><dd class="mono">@link.PacketsRetransmitted.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
                <div><dt>Latency</dt><dd class="mono">@link.NegotiatedLatencyMs ms</dd></div>
                <div><dt>Undecrypted</dt><dd class="mono @(link.UndecryptedPacketsTotal > 0 ? "danger-text" : null)">@link.UndecryptedPacketsTotal.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
            }
            else if (Row.Stream is not null)
            {
                <div class="unavailable"><dt>Link statistics</dt><dd>@(Row.Source.IsPull ? "Unavailable for a pulled stream" : "Unavailable")</dd></div>
            }
        </dl>
    </section>

    <section class="detail-card detection-card">
        <header>
            <div><span class="overline">Vision</span><strong>Object detection</strong></div>
            <StatusBadge Text="@DetectionState" Tone="@(Row.Stream?.DetectionEnabled == true ? "success" : "neutral")" />
        </header>

        @if (Row.Stream is null)
        {
            <p class="detection-hint">Detection can be configured when this source is on air.</p>
        }
        else
        {
            <div class="detection-form">
                <label>
                    <span>Model</span>
                    <select @bind="_model" disabled="@_savingDetection">
                        <option value="">Worker default</option>
                        <option value="rf-detr">RF-DETR Nano</option>
                        <option value="yolo26">YOLO26 Nano</option>
                    </select>
                </label>
                <label>
                    <span>Rate</span>
                    <select @bind="_rate" disabled="@_savingDetection">
                        <option value="0">Worker default</option>
                        <option value="1">1 / second</option>
                        <option value="5">5 / second</option>
                        <option value="25">25 / second</option>
                    </select>
                </label>

                <div class="label-heading">
                    <span>Visible classes</span>
                    <span class="label-actions">
                        <button type="button" @onclick="SelectRoadLabels">Road traffic</button>
                        <button type="button" @onclick="SelectAllLabels">All</button>
                    </span>
                </div>
                <details class="label-picker">
                    <summary>@LabelSummary</summary>
                    <div class="label-grid">
                        @foreach (var label in CocoClasses.All)
                        {
                            <label>
                                <input type="checkbox" checked="@_labels.Contains(label)"
                                       @onchange="@(args => SetLabel(label, args))" />
                                <span>@label</span>
                            </label>
                        }
                    </div>
                </details>

                @if (_detectionError is not null)
                {
                    <span class="field-error" role="alert">@_detectionError</span>
                }

                <div class="detection-actions">
                    <button type="button" class="button secondary" disabled="@_savingDetection"
                            @onclick="@(() => SaveDetectionAsync(!Row.Stream.DetectionEnabled))">
                        @(Row.Stream.DetectionEnabled ? "Stop detection" : "Start detection")
                    </button>
                    <button type="button" class="button primary" disabled="@_savingDetection"
                            @onclick="@(() => SaveDetectionAsync(Row.Stream.DetectionEnabled))">Apply settings</button>
                </div>
            </div>
        }
    </section>

    @foreach (var (target, status) in Row.Detail)
    {
        <section class="detail-card" @key="target.Id">
            <header>
                <div><span class="overline">Forward</span><strong title="@target.Url">@DestinationName(target.Url)</strong></div>
                <StatusBadge Text="@ForwardText(target, status)" Tone="@ForwardTone(target, status)" />
            </header>
            <dl>
                <div class="url-row"><dt>URL</dt><dd class="mono" title="@target.Url">@target.Url</dd></div>
                <div><dt>Transferred</dt><dd class="mono">@(status is null ? "—" : FormatSize(status.Bytes))</dd></div>
                @if (status?.Link is { } forwardLink)
                {
                    <div><dt>Bandwidth</dt><dd class="mono">@FormatMbps(forwardLink.BandwidthMbps)</dd></div>
                    <div><dt>Send rate</dt><dd class="mono">@FormatMbps(forwardLink.SendRateMbps)</dd></div>
                    <div><dt>Round trip</dt><dd class="mono">@forwardLink.RoundTripTimeMs.ToString("0", CultureInfo.InvariantCulture) ms</dd></div>
                    <div><dt>Retransmitted</dt><dd class="mono">@forwardLink.PacketsRetransmitted.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
                    <div><dt>Latency</dt><dd class="mono">@forwardLink.NegotiatedLatencyMs ms</dd></div>
                    @if (status.PacketsLost > 0 || status.PacketsDropped > 0)
                    {
                        <div><dt>Lost / dropped</dt><dd class="mono warning-text">@status.PacketsLost.ToString("N0", CultureInfo.InvariantCulture) / @status.PacketsDropped.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
                    }
                }
                else if (target.Url.StartsWith("udp://", StringComparison.OrdinalIgnoreCase)
                    || target.Url.StartsWith("rtp://", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="unavailable"><dt>Link statistics</dt><dd>Unavailable for this protocol</dd></div>
                }
                @if (status?.Error is { } error)
                {
                    <div class="error-row"><dt>Last error</dt><dd>@error</dd></div>
                }
            </dl>
        </section>
    }

    <div class="details-actions">
        <button type="button" class="button secondary edit-forwards" @onclick="Edit">
            <AppIcon Name="edit" /> Configure source and forwards
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SourceRow Row { get; set; } = default!;
    [Parameter] public EventCallback Edit { get; set; }
    [Parameter] public EventCallback DetectionChanged { get; set; }

    private static readonly string[] RoadLabels = ["person", "bicycle", "car", "motorcycle", "bus", "truck"];
    private readonly HashSet<string> _labels = new(StringComparer.Ordinal);
    private string _model = string.Empty;
    private int _rate;
    private bool _savingDetection;
    private string? _detectionError;
    private bool _settingsLoaded;

    protected override void OnParametersSet()
    {
        // The parent receives a fresh row every heartbeat. Load once per expanded component so an
        // operator ticking boxes is not reset by the next two-second refresh.
        if (_settingsLoaded || Row.Stream is null) return;
        _settingsLoaded = true;
        _model = Row.Stream.DetectionModel ?? string.Empty;
        _rate = Row.Stream.DetectionRate;
        _labels.Clear();
        foreach (var label in Row.Stream.DetectionLabels ?? []) _labels.Add(label);
        if (_labels.Count == 0) _labels.UnionWith(CocoClasses.All);
    }

    private string DetectionState => Row.Stream switch
    {
        null => "Unavailable",
        { DetectionEnabled: true, DetectionWorker: not null } => "Running",
        { DetectionEnabled: true } => "Waiting for worker",
        _ => "Off",
    };

    private string LabelSummary => _labels.Count switch
    {
        0 => "No classes selected",
        var count when count == CocoClasses.All.Count => $"All {count} COCO classes",
        _ => $"{_labels.Count} of {CocoClasses.All.Count} classes",
    };

    private void SelectRoadLabels()
    {
        _labels.Clear();
        _labels.UnionWith(RoadLabels);
    }

    private void SelectAllLabels()
    {
        _labels.Clear();
        _labels.UnionWith(CocoClasses.All);
    }

    private void SetLabel(string label, ChangeEventArgs args)
    {
        if (args.Value is true) _labels.Add(label);
        else _labels.Remove(label);
    }

    private async Task SaveDetectionAsync(bool enabled)
    {
        if (Row.Stream is null) return;
        _savingDetection = true;
        _detectionError = null;
        try
        {
            // Empty is an explicit "none" in this UI. The transport uses empty for "all", so
            // selecting none is refused here instead of surprisingly making every box return.
            if (_labels.Count == 0)
            {
                _detectionError = "Select at least one class, or use All.";
                return;
            }

            var labels = _labels.Count == CocoClasses.All.Count ? Array.Empty<string>() : [.. _labels];
            var result = await ConfigurationService.ConfigureDetectionAsync(
                Row.Source.Name, enabled, _rate, _model, labels, CancellationToken.None);
            if (!result.Succeeded)
            {
                _detectionError = result.Error;
                return;
            }

            await DetectionChanged.InvokeAsync();
        }
        finally
        {
            _savingDetection = false;
        }
    }

    private static string StateText(SourceState state) => state switch
    {
        SourceState.Live => "Streaming",
        SourceState.Interrupted => "Interrupted",
        _ => "Not on air",
    };

    private static string StateTone(SourceState state) => state switch
    {
        SourceState.Live => "success",
        SourceState.Interrupted => "warning",
        _ => "neutral",
    };

    private string ForwardText(ForwardTarget target, ForwardStatus? status) => status switch
    {
        { Connected: true } => "Connected",
        { } => "Not connected",
        _ when !target.Enabled => "Off",
        _ when Row.State == SourceState.NotOnAir => "Waiting for source",
        _ => "Not running",
    };

    private static string ForwardTone(ForwardTarget target, ForwardStatus? status)
        => status is { Connected: true } ? "success" : target.Enabled ? "warning" : "neutral";

    private static string DestinationName(string url)
        => Uri.TryCreate(url, UriKind.Absolute, out var parsed) ? parsed.Host : "Destination";

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1L << 30 => (bytes / (double)(1L << 30)).ToString("0.0", CultureInfo.InvariantCulture) + " GB",
        >= 1L << 20 => (bytes / (double)(1L << 20)).ToString("0.0", CultureInfo.InvariantCulture) + " MB",
        >= 1L << 10 => (bytes / (double)(1L << 10)).ToString("0", CultureInfo.InvariantCulture) + " kB",
        _ => bytes + " B",
    };

    private static string FormatMbps(double mbps) => mbps >= 10
        ? mbps.ToString("0", CultureInfo.InvariantCulture) + " Mb/s"
        : mbps.ToString("0.00", CultureInfo.InvariantCulture) + " Mb/s";
}
