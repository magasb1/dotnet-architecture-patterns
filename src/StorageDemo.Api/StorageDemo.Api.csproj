<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>storage-demo</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StorageDemo.Infrastructure\StorageDemo.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <!-- Reads a file's real type from its magic bytes. Needs the ASP.NET framework reference,
         which is why upload validation lives here rather than in Core. -->
    <PackageReference Include="MagicBytesValidator" Version="2.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\protos\documents.proto" GrpcServices="Both" Link="Protos\documents.proto" />
  </ItemGroup>
</Project>
