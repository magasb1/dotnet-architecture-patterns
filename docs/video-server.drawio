<mxfile host="app.diagrams.net" agent="storage-demo" version="24.7.17" type="device">
  <diagram id="step-by-step" name="Step by step">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1t1" value="How it works, one step at a time" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="p1t2" value="One address to push to, one to watch on, and a name. The name is read before a connection exists, and everything else follows from that." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="p1g1" value="A camera goes on air" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="540" height="720" as="geometry"/></mxCell>
        <mxCell id="p1s1" value="&lt;b&gt;1 &amp;#8194;The encoder connects and names itself&lt;/b&gt;&lt;br/&gt;One address, the same one forever. The name travels in the SRT stream identifier, and nobody set anything up beforehand." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="65" y="160" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s2" value="&lt;b&gt;2 &amp;#8194;The name is read before the connection exists&lt;/b&gt;&lt;br/&gt;libsrt&#x27;s handshake callback fires when the conclusion handshake arrives and is handed the identifier directly. Nothing has been accepted yet." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="65" y="290" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s3" value="&lt;b&gt;3 &amp;#8194;Admitted, or refused with a code&lt;/b&gt;&lt;br/&gt;A name that is already live and held is refused, and the rejection code travels back to the caller. Nothing is accepted and then quietly dropped." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="65" y="420" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s4" value="&lt;b&gt;4 &amp;#8194;The claim re-checks under the lock&lt;/b&gt;&lt;br/&gt;The handshake answered from a cache the heartbeat refreshes, so it can be one beat stale. The claim takes the distributed lock, reads the registry again, and closes the socket if the name is held after all." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="65" y="550" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s5" value="&lt;b&gt;5 &amp;#8194;The demultiplexer feeds the hub&lt;/b&gt;&lt;br/&gt;One demultiplexer per stream, one hub, packets one way. The last thirty seconds are held as segments whether or not anyone is watching." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="65" y="680" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="p1e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s1" target="p1s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s2" target="p1s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s3" target="p1s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s4" target="p1s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1g2" value="Watching and recording" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="540" height="720" as="geometry"/></mxCell>
        <mxCell id="p1s6" value="&lt;b&gt;6 &amp;#8194;Someone watches&lt;/b&gt;&lt;br/&gt;They call the consumption port and name the stream they want, exactly as an encoder names the stream it is sending." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="645" y="160" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s7" value="&lt;b&gt;7 &amp;#8194;A viewer that landed elsewhere is served from the owner&lt;/b&gt;&lt;br/&gt;Only the owner has the bytes. The replica the player reached asks for them over ordinary HTTP, &lt;b&gt;GET /api/live/peer/view/{name}&lt;/b&gt;, and copies the answer into the player&#x27;s own SRT socket. &lt;i&gt;Measured:&lt;/i&gt; joining costs 1.93 s on the owner against 1.81 s relayed." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="645" y="290" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s8" value="&lt;b&gt;8 &amp;#8194;Someone presses record&lt;/b&gt;&lt;br/&gt;The recorder reaches back into the rolling buffer and starts at a segment, so the recording begins before the button was pressed." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="645" y="420" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s9" value="&lt;b&gt;9 &amp;#8194;Every few minutes a part is filed away&lt;/b&gt;&lt;br/&gt;Muxed to local disk, uploaded, deleted. A six hour recording never sits on one machine &amp;#8212; only the part in progress does." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="645" y="550" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s10" value="&lt;b&gt;10 &amp;#8194;You see one file&lt;/b&gt;&lt;br/&gt;One name, one size, one download. The parts are joined on the way out, and you can jump to any point in it." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="645" y="680" width="490" height="110" as="geometry"/></mxCell>
        <mxCell id="p1e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s6" target="p1s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s7" target="p1s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s8" target="p1s9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s9" target="p1s10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1g3" value="When a machine disappears" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="520" height="720" as="geometry"/></mxCell>
        <mxCell id="p1s11" value="&lt;b&gt;11 &amp;#8194;The camera notices and redials&lt;/b&gt;&lt;br/&gt;Same address as always. It does not need to know that anything happened, and nobody has to reconfigure it." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1225" y="160" width="470" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s12" value="&lt;b&gt;12 &amp;#8194;The lock lets go when the feed does&lt;/b&gt;&lt;br/&gt;A live name is held. An interrupted one is not, and an owner that has missed three heartbeats holds nothing. About six seconds, not thirty." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1225" y="290" width="470" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s13" value="&lt;b&gt;13 &amp;#8194;Another replica claims the name and resumes&lt;/b&gt;&lt;br/&gt;Because the name is the identity, this is the &lt;i&gt;same&lt;/i&gt; stream carrying on &amp;#8212; not a second one that happens to look like it." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1225" y="420" width="470" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s14" value="&lt;b&gt;14 &amp;#8194;Anyone watching keeps watching&lt;/b&gt;&lt;br/&gt;Their connection is held open and quietly re-pointed at wherever the stream went. They see a gap in the picture, not a disconnection." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1225" y="550" width="470" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s15" value="&lt;b&gt;15 &amp;#8194;What was already recorded is safe&lt;/b&gt;&lt;br/&gt;Every part filed away in step 9 is already stored. At worst the part in progress is lost." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1225" y="680" width="470" height="110" as="geometry"/></mxCell>
        <mxCell id="p1e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s11" target="p1s12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s12" target="p1s13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s13" target="p1s14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s14" target="p1s15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#b0b7c3;" edge="1" parent="1" source="p1s5" target="p1s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#b0b7c3;" edge="1" parent="1" source="p1s10" target="p1s11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1n1" value="&lt;b&gt;What the handshake can answer&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Before a connection exists, the callback parses the stream identifier and either admits it or sets a rejection code that travels back to the caller.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;1400&lt;/b&gt; the name will not parse, or it is a publisher on the consumption port&lt;br/&gt;• &lt;b&gt;1409&lt;/b&gt; the name is live and held. This is the name lock&lt;br/&gt;• &lt;b&gt;1402&lt;/b&gt; the pod is full, at its configured stream ceiling&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Measured:&lt;/i&gt; twenty senders started together were all accepted in &lt;b&gt;211 ms&lt;/b&gt;. What this replaced accepted one caller and re-opened its own listening socket, which managed two or three a second." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="540" height="290" as="geometry"/></mxCell>
        <mxCell id="p1n2" value="&lt;b&gt;A live name is locked&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;While &lt;b&gt;demo&lt;/b&gt; is live and its owner is heartbeating, a second publisher of &lt;b&gt;demo&lt;/b&gt; is refused. It does not take the name over.&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Measured on two real pods:&lt;/i&gt; a second publisher of a live name was refused on the other pod in about half a second, the code arriving intact at the caller, while the incumbent&#x27;s packet counter kept rising.&lt;br/&gt;&lt;br/&gt;The name is free again when the feed is &lt;b&gt;interrupted&lt;/b&gt;, when the owner has missed three heartbeats, or when nobody owns it &amp;#8212; and whoever claims it then resumes the same stream rather than starting a second one.&lt;br/&gt;&lt;br/&gt;The lock is a collision guard and not authentication. An impostor arriving while the real encoder is down is admitted. An SRT passphrase is the security measure, and it is planned." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="860" width="540" height="290" as="geometry"/></mxCell>
        <mxCell id="p1lg" value="Built, and planned" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1200" y="860" width="520" height="300" as="geometry"/></mxCell>
        <mxCell id="p1lb" value="Built" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1225" y="910" width="200" height="45" as="geometry"/></mxCell>
        <mxCell id="p1lp" value="Planned" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1470" y="910" width="200" height="45" as="geometry"/></mxCell>
        <mxCell id="p1lt" value="&lt;b&gt;Built&lt;/b&gt; &amp;#8212; the libsrt listener and its handshake gate, the name lock, the latency option, multi-port ingest, the HTTP hop that serves a viewer from another pod, the KLV extractor, a full pod refusing a caller, leases for pulled streams, and the worker tier: the lease, decode at the detection rate, RF-DETR Nano on ONNX Runtime, ByteTrack, VMTI posted back to the owner. Also built, off this page &amp;#8212; the gateway: configured sources, forwarding to another server over SRT, UDP or RTP, and the operator page for both.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Planned&lt;/b&gt;, drawn dashed and grey on every page &amp;#8212; the ingest and consumption passphrase; and in the worker tier the GPU, VMTI muxed into the SRT output, the preview as its by-product, YOLO as the second model, and geo-referencing.&lt;br/&gt;&lt;br/&gt;Nothing on these pages is asserted as working unless it is drawn solid." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1225" y="975" width="470" height="180" as="geometry"/></mxCell>
        <mxCell id="p1t3" value="Nothing ever points at a particular machine, and nothing is accepted before its name has been checked. Those two rules are what let machines be added, removed and replaced without touching a single camera or player." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="2240" height="40" as="geometry"/></mxCell>
        <mxCell id="p1g4" value="Detection, switched on per stream" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1760" y="110" width="520" height="720" as="geometry"/></mxCell>
        <mxCell id="p1s16" value="&lt;b&gt;16 &amp;#8194;Detect is switched on through the owner&lt;/b&gt;&lt;br/&gt;A toggle per stream at 1, 5 or 25 a second, guarded and forwarded to the owner exactly like record and snapshot. It is the server&#x27;s state and outlives the window that set it." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1785" y="160" width="470" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s17" value="&lt;b&gt;17 &amp;#8194;A worker claims it by lease&lt;/b&gt;&lt;br/&gt;Every beat a worker lists the streams, claims one whose toggle is on and nobody holds by writing its name to the owner, and renews by the same call. A holder silent for five beats loses it. Nothing pushes work to a worker." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1785" y="290" width="470" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s18" value="&lt;b&gt;18 &amp;#8194;It subscribes, and decodes only at the detection rate&lt;/b&gt;&lt;br/&gt;Over the same peer view route a viewer is served from, into a private hub. Keyframes when the rate allows; the tracker predicts between detections without a frame, so nothing is decoded that will not be detected on." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1785" y="420" width="470" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s19" value="&lt;b&gt;19 &amp;#8194;Detections go back as VMTI&lt;/b&gt;&lt;br/&gt;RF-DETR Nano through ONNX Runtime, tracks from ByteTrack, encoded as MISB ST 0903 and posted to the owner, which keeps a ring of sixteen and serves the newest on REST and gRPC. Never burned into the picture, never nested in the platform metadata." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1785" y="550" width="470" height="110" as="geometry"/></mxCell>
        <mxCell id="p1s20" value="&lt;b&gt;20 &amp;#8194;The client draws the boxes&lt;/b&gt;&lt;br/&gt;Polled once a second and drawn in the player&#x27;s own overlay, scaled to the rectangle the renderer actually painted, coloured per track. The panel says how old they are. A capture can name the detection that caused it." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1785" y="680" width="470" height="110" as="geometry"/></mxCell>
        <mxCell id="p1e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s16" target="p1s17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s17" target="p1s18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s18" target="p1s19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p1s19" target="p1s20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1n3" value="&lt;b&gt;Measured, on a processor&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;RF-DETR Nano through ONNX Runtime takes &lt;b&gt;about 540 ms a frame&lt;/b&gt; on this processor. That is why one detection a second is the developer setting, and why a replica holds a handful of streams until a GPU exists.&lt;br/&gt;&lt;br/&gt;The &lt;b&gt;first dog was served 5.8 s&lt;/b&gt; after the worker started, model load included.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;OpenCV 5&lt;/b&gt; was measured on the same export: as fast as ONNX Runtime on a processor, identical boxes, but no GPU backend from its NuGet packages. ONNX Runtime ships CUDA from NuGet, so it stays.&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Still planned, and still dashed:&lt;/i&gt; the GPU, VMTI muxed into the SRT output, the preview as the worker&#x27;s by-product, YOLO, geo-referencing." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1760" y="860" width="520" height="300" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="1-the-shape" name="1. The shape">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2t1" value="Video server &amp;#8212; three ports on one address, and a worker tier beside them" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="p2t2" value="An encoder connects and names itself in the SRT stream identifier. Nothing is requested first. The handshake reads that name before the connection exists and either admits or refuses it, and the replica that admits it owns the stream for as long as the feed is live." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="p2g1" value="Cameras" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="290" as="geometry"/></mxCell>
        <mxCell id="p2c1" value="Encoder 1&lt;br/&gt;SRT caller" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="p2c2" value="Encoder 2&lt;br/&gt;SRT caller" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="p2c3" value="Encoder 3&lt;br/&gt;SRT caller" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="p2svcin" value="&lt;b&gt;Ingest Service&lt;/b&gt;&lt;br/&gt;LoadBalancer, UDP 9000 and up&lt;br/&gt;push a stream, nothing else&lt;br/&gt;&lt;i&gt;one port by default; one receive thread per bound port&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="195" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="p2gdep" value="Deployment &amp;#8212; replicas, no pod identity" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="550" y="110" width="660" height="620" as="geometry"/></mxCell>
        <mxCell id="p2grepa" value="Replica A &amp;#8212; owns camera-1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="575" y="150" width="610" height="250" as="geometry"/></mxCell>
        <mxCell id="p2la" value="libsrt listener&lt;br/&gt;the handshake gate" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="595" y="190" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="p2ha" value="hub&lt;br/&gt;+ rolling buffer" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="770" y="190" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="p2reca" value="recorder" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="945" y="180" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="p2klva" value="KLV extractor" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="945" y="225" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="p2va" value="viewer out" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="770" y="300" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="p2fwda" value="forwarder(s) &amp;#8594; another server, SRT/UDP/RTP" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="945" y="270" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="p2e1" value="packets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2la" target="p2ha"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2ha" target="p2reca"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2ha" target="p2klva"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2ha" target="p2va"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2ha" target="p2fwda"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2grepb" value="Replica B &amp;#8212; owns nothing yet" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="575" y="440" width="610" height="250" as="geometry"/></mxCell>
        <mxCell id="p2lb" value="libsrt listener&lt;br/&gt;the handshake gate" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="595" y="485" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="p2hb" value="hub&lt;br/&gt;+ rolling buffer" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="770" y="485" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="p2relb" value="serves a viewer&lt;br/&gt;from the owner,&lt;br/&gt;over HTTP" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="945" y="480" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="p2e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2lb" target="p2hb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2svcapi" value="&lt;b&gt;API Service&lt;/b&gt;&lt;br/&gt;REST 8080, gRPC 5080&lt;br/&gt;documents and control" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1280" y="150" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="p2svccon" value="&lt;b&gt;Consumption Service&lt;/b&gt;&lt;br/&gt;LoadBalancer, UDP 9010&lt;br/&gt;watch live, nothing else" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1280" y="310" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="p2cli" value="Desktop client&lt;br/&gt;gRPC" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1560" y="150" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="p2ply" value="Players&lt;br/&gt;SRT caller&lt;br/&gt;ffplay, desktop client" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1560" y="310" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="p2gwk" value="Worker tier &amp;#8212; built. Its own Deployment, on processor nodes today" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1280" y="450" width="480" height="300" as="geometry"/></mxCell>
        <mxCell id="p2wk1" value="claims a stream by lease, subscribes to it&lt;br/&gt;packets over HTTP from the owner, into a private hub" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1305" y="490" width="430" height="50" as="geometry"/></mxCell>
        <mxCell id="p2wk2" value="decoder &amp;#8212; only at the detection rate,&lt;br/&gt;keyframes when the rate allows" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1305" y="555" width="270" height="50" as="geometry"/></mxCell>
        <mxCell id="p2wk5" value="on the GPU&lt;br/&gt;CUDA picked up when present" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1585" y="555" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="p2wk3" value="RF-DETR Nano on ONNX Runtime,&lt;br/&gt;ByteTrack &amp;#8594; MISB ST 0903 VMTI" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1305" y="620" width="270" height="50" as="geometry"/></mxCell>
        <mxCell id="p2wk4" value="preview thumbnail&lt;br/&gt;as a by-product" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1585" y="620" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="p2wk6" value="posts each VMTI frame to the owner &amp;#8212; a ring of sixteen, served on REST and gRPC" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1305" y="685" width="430" height="50" as="geometry"/></mxCell>
        <mxCell id="p2ew1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2wk1" target="p2wk2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2ew2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2wk2" target="p2wk3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2ew4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2wk3" target="p2wk6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2ew3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#999999;fontColor=#666666;" edge="1" parent="1" source="p2wk2" target="p2wk4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br/&gt;registry: name &amp;#8594; owner, heartbeat&lt;br/&gt;lock: serialises a claim&lt;br/&gt;source store: pull sources, forwards" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="575" y="790" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="p2e23" value="reconciles configured sources every beat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2fwda" target="p2redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1195" y="287"/><mxPoint x="1195" y="750"/><mxPoint x="710" y="750"/></Array></mxGeometry></mxCell>
        <mxCell id="p2obj" value="&lt;b&gt;Object storage&lt;/b&gt; &amp;#8212; S3 or filesystem&lt;br/&gt;recordings/{id}/00000.ts &amp;#8230; parts&lt;br/&gt;documents/&amp;#8194;&amp;#8194;&amp;#8194;thumbnails/" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="895" y="790" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="p2db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br/&gt;one row per document,&lt;br/&gt;carrying its part list" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1235" y="790" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="p2e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2c1" target="p2svcin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2c2" target="p2svcin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2c3" target="p2svcin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e9" value="the load balancer picks a pod" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2svcin" target="p2la"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2svcin" target="p2lb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2ply" target="p2svccon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e12" value="lands anywhere" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2svccon" target="p2relb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e13" value="fetched over HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2relb" target="p2ha"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1055" y="420"/><mxPoint x="760" y="420"/><mxPoint x="760" y="226"/></Array></mxGeometry></mxCell>
        <mxCell id="p2e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p2cli" target="p2svcapi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e15" value="any replica answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="p2svcapi" target="p2hb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e16" value="forwarded over HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#6c8ebf;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2hb" target="p2ha"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="845" y="415"/><mxPoint x="750" y="415"/><mxPoint x="750" y="214"/></Array></mxGeometry></mxCell>
        <mxCell id="p2e17" value="claims the name under the lock,&lt;br/&gt;records its own pod IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#9673a6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2ha" target="p2redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="555" y="220"/><mxPoint x="555" y="829"/></Array></mxGeometry></mxCell>
        <mxCell id="p2e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#9673a6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2hb" target="p2redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="565" y="515"/><mxPoint x="565" y="855"/></Array></mxGeometry></mxCell>
        <mxCell id="p2e19" value="parts, as they complete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="p2reca" target="p2obj"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e20" value="one document" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="p2reca" target="p2db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2e21" value="one packet subscriber per stream, over HTTP;&lt;br/&gt;VMTI posted back on the same hop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2wk1" target="p2ha"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="515"/><mxPoint x="1240" y="420"/><mxPoint x="755" y="420"/><mxPoint x="755" y="220"/></Array></mxGeometry></mxCell>
        <mxCell id="p2n1" value="&lt;b&gt;Why this shape&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;One address per purpose.&lt;/b&gt; Reaching ingest lets you push a stream and nothing else; reaching consumption lets you watch and nothing else. That is what keeps the firewall statement to one sentence per port.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;The name is the identity.&lt;/b&gt; The registry is keyed by name, so a camera that drops and reconnects resumes the same stream rather than creating a second one.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;A live name is locked.&lt;/b&gt; The handshake reads the name before a connection exists and refuses a second publisher of a name that is live and held. The name is free again when the feed is interrupted or the owner has missed three heartbeats, and whoever claims it then resumes that same stream." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="470" height="280" as="geometry"/></mxCell>
        <mxCell id="p2n2" value="&lt;b&gt;Only the owner has the bytes&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A stream&#x27;s packets exist on exactly one replica. Everything else is routed to it:&lt;br/&gt;&lt;br/&gt;• a control call reaching another replica is &lt;b&gt;forwarded over HTTP&lt;/b&gt;&lt;br/&gt;• a viewer landing on another replica is &lt;b&gt;served from the owner over HTTP&lt;/b&gt;, &lt;b&gt;GET /api/live/peer/view/{name}&lt;/b&gt;, whose body is copied into the viewer&#x27;s own SRT socket. SRT reaches the viewer and nothing else changed for them. &lt;i&gt;Measured:&lt;/i&gt; 1.93 s to join on the owner against 1.81 s relayed, the same number inside the rig&#x27;s noise; the SRT-to-SRT hop this replaced cost 1.78 s against 3.76 s&lt;br/&gt;• the &lt;b&gt;worker tier&lt;/b&gt; subscribes the same way, from outside the pod, and posts its VMTI frames back to the owner over the same hop&lt;br/&gt;&lt;br/&gt;So a caller never has to know which pod took the stream, and nothing points at a particular pod. That is what allows a Deployment rather than a StatefulSet." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="470" height="285" as="geometry"/></mxCell>
        <mxCell id="p2lg" value="Built, and planned" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="1075" width="470" height="190" as="geometry"/></mxCell>
        <mxCell id="p2lb1" value="Built" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="1115" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="p2lp1" value="Planned" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="1115" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="p2lt1" value="Dashed and grey is planned, not built. Built here: the libsrt listener and its handshake gate, the name lock, the latency option, multi-port ingest, the HTTP hop that serves a viewer from another pod, the KLV extractor, and the worker tier on processor nodes. Planned: the GPU, the preview as the worker&#x27;s by-product, VMTI muxed into the SRT output." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1163" width="430" height="95" as="geometry"/></mxCell>
        <mxCell id="p2n3" value="&lt;b&gt;Measured, on a processor&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;About 540 ms a frame&lt;/b&gt; for RF-DETR Nano through ONNX Runtime on this processor, so one detection a second is the developer setting and one replica holds a handful of streams until a GPU exists. The &lt;b&gt;first dog was served 5.8 s&lt;/b&gt; after worker start, model load included.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;OpenCV 5&lt;/b&gt; on the same export was as fast on a processor, with identical boxes, but its NuGet packages carry no GPU backend; ONNX Runtime ships CUDA from NuGet and stays.&lt;br/&gt;&lt;br/&gt;Detections never touch the picture: not burned in, not nested in the platform metadata. A standalone ST 0903 stream on the same clock." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1235" y="930" width="525" height="230" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="2-inside-one-replica" name="2. Inside one replica">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3t1" value="Inside one replica &amp;#8212; packet work only, and the frame tier moved out for detection" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="p3t2" value="Packets flow one way, and every subscriber left in this pod reads packets without decoding them. Detection&#x27;s decode has left: a worker decodes a stream only at its detection rate and posts VMTI back. The preview still decodes here, until it becomes the worker&#x27;s by-product." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="p3gpod" value="Ingest pod &amp;#8212; packet work only" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1260" height="540" as="geometry"/></mxCell>
        <mxCell id="p3lis" value="libsrt listener&lt;br/&gt;the handshake gate&lt;br/&gt;&lt;i&gt;one receive thread per bound port; ingest can bind several&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="65" y="165" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="p3dmx" value="demultiplexer&lt;br/&gt;one per stream" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="175" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="p3hub" value="&lt;b&gt;hub&lt;/b&gt;&lt;br/&gt;the fan-out point" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="530" y="170" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="p3buf" value="&lt;b&gt;rolling buffer&lt;/b&gt;&lt;br/&gt;held as segments&lt;br/&gt;30 s or a byte ceiling,&lt;br/&gt;whichever binds first" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="p3e1" value="accepted socket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3lis" target="p3dmx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e2" value="packets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3dmx" target="p3hub"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e3" value="always buffering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3hub" target="p3buf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3gpk" value="Packet subscribers &amp;#8212; not one of them decodes" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="780" y="150" width="490" height="280" as="geometry"/></mxCell>
        <mxCell id="p3rec" value="recorder&lt;br/&gt;parts &amp;#8594; object storage" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="805" y="190" width="215" height="60" as="geometry"/></mxCell>
        <mxCell id="p3vw" value="viewer&lt;br/&gt;its own muxer &amp;#8594; SRT" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="805" y="270" width="215" height="60" as="geometry"/></mxCell>
        <mxCell id="p3klv" value="&lt;b&gt;KLV extractor&lt;/b&gt;&lt;br/&gt;a subscriber on another&lt;br/&gt;stream index, a ring of&lt;br/&gt;the newest packets&lt;br/&gt;&lt;b&gt;no decoder at all&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1040" y="190" width="215" height="140" as="geometry"/></mxCell>
        <mxCell id="p3fwd" value="forwarder&lt;br/&gt;its own muxer &amp;#8594; SRT, UDP or RTP,&lt;br/&gt;to another server" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1040" y="350" width="215" height="70" as="geometry"/></mxCell>
        <mxCell id="p3e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3hub" target="p3rec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3hub" target="p3vw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e17" value="reads the shared source store, not pushed to" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3hub" target="p3fwd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="210"/><mxPoint x="760" y="410"/><mxPoint x="1147" y="410"/></Array></mxGeometry></mxCell>
        <mxCell id="p3e6" value="another stream index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3hub" target="p3klv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="140"/><mxPoint x="1147" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="p3gfr" value="Frame tier &amp;#8212; removed from this pod for detection; the preview still decodes here" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="70" y="450" width="910" height="180" as="geometry"/></mxCell>
        <mxCell id="p3dec" value="decoder &amp;#8212; keyframes only, for the preview&lt;br/&gt;&lt;i&gt;still runs here; detection&#x27;s decode has already left for the worker&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="100" y="500" width="410" height="80" as="geometry"/></mxCell>
        <mxCell id="p3har" value="preview harvester &amp;#8212; the picture now&lt;br/&gt;&lt;i&gt;still runs here; becoming a by-product of the worker&#x27;s decode is planned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="540" y="500" width="410" height="80" as="geometry"/></mxCell>
        <mxCell id="p3gwk" value="Worker tier &amp;#8212; built. Another Deployment, on processor nodes today" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1380" y="110" width="480" height="330" as="geometry"/></mxCell>
        <mxCell id="p3wsub" value="claims a stream by lease and subscribes to it&lt;br/&gt;packets over HTTP, video and KLV together, into a private hub" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1405" y="160" width="430" height="60" as="geometry"/></mxCell>
        <mxCell id="p3wdec" value="&lt;b&gt;decoder&lt;/b&gt; &amp;#8212; only at the detection rate,&lt;br/&gt;keyframes when the rate allows" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1405" y="250" width="270" height="60" as="geometry"/></mxCell>
        <mxCell id="p3wgpu" value="on the GPU&lt;br/&gt;CUDA picked up when present" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1685" y="250" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="p3wdet" value="&lt;b&gt;RF-DETR Nano&lt;/b&gt; on ONNX Runtime;&lt;br/&gt;ByteTrack predicts between detections" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1405" y="340" width="270" height="60" as="geometry"/></mxCell>
        <mxCell id="p3wprv" value="preview thumbnail&lt;br/&gt;as a by-product" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1685" y="340" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="p3e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3wsub" target="p3wdec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e8" value="frames" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3wdec" target="p3wdet"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#999999;fontColor=#666666;" edge="1" parent="1" source="p3wdec" target="p3wprv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3obj" value="object storage" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="805" y="665" width="215" height="60" as="geometry"/></mxCell>
        <mxCell id="p3cons" value="consumption port" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1045" y="665" width="215" height="60" as="geometry"/></mxCell>
        <mxCell id="p3back" value="each VMTI frame posted to the owner&lt;br/&gt;a ring of sixteen, served on REST and gRPC" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1405" y="665" width="270" height="60" as="geometry"/></mxCell>
        <mxCell id="p3mux" value="VMTI muxed into the&lt;br/&gt;SRT output" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1685" y="665" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="p3e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3rec" target="p3obj"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3vw" target="p3cons"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e12" value="ST 0903, on the stream&#x27;s clock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3wdet" target="p3back"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e16" value="same bytes, one muxer away" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#999999;fontColor=#666666;" edge="1" parent="1" source="p3back" target="p3mux"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#999999;fontColor=#666666;" edge="1" parent="1" source="p3wprv" target="p3back"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e14" value="over the owner&#x27;s view route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3vw" target="p3wsub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="912" y="415"/><mxPoint x="1340" y="415"/><mxPoint x="1340" y="190"/></Array></mxGeometry></mxCell>
        <mxCell id="p3e15" value="detection has moved; the preview follows, planned" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3gfr" target="p3gwk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="540"/><mxPoint x="1320" y="275"/></Array></mxGeometry></mxCell>
        <mxCell id="p3n1" value="&lt;b&gt;The buffer answers three questions with one mechanism&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;It is held as &lt;b&gt;segments&lt;/b&gt;, each beginning where a decoder can start. So:&lt;br/&gt;&lt;br/&gt;• a viewer &lt;b&gt;joins&lt;/b&gt; at a segment&lt;br/&gt;• a viewer &lt;b&gt;rolls back&lt;/b&gt; to a segment&lt;br/&gt;• a recording&#x27;s &lt;b&gt;pre-roll&lt;/b&gt; is cut at a segment&lt;br/&gt;&lt;br/&gt;All three are &amp;#8220;choose a segment&amp;#8221;, and eviction is &amp;#8220;drop the oldest&amp;#8221;. The cost is granularity and it is the sender&#x27;s to control: a segment is its keyframe interval, so the window promise is &lt;i&gt;at least&lt;/i&gt; the seconds asked for, never exactly." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="620" height="250" as="geometry"/></mxCell>
        <mxCell id="p3n2" value="&lt;b&gt;Backpressure means different things&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Every subscriber has a bounded queue. An unbounded one turns a slow viewer into a memory leak, and blocking turns one into a stall on ingest.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;A viewer that falls behind skips forward to live.&lt;/b&gt; Unintended lag is a fault; only a deliberate rollback is a chosen position.&lt;br/&gt;• &lt;b&gt;A recorder that overflows stops&lt;/b&gt; and marks its document truncated. Dropping packets would write a hole into a file that claims to be a recording." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="620" height="210" as="geometry"/></mxCell>
        <mxCell id="p3n3" value="&lt;b&gt;A recording is written in parts&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A camera recording for six hours cannot wait until it ends to be stored. A few minutes are muxed to local disk, uploaded as an ordinary object, and the local file deleted.&lt;br/&gt;&lt;br/&gt;• disk and memory bounded by &lt;b&gt;one part&lt;/b&gt;, whatever the total length&lt;br/&gt;• a pod that dies loses &lt;b&gt;at most the part in progress&lt;/b&gt;&lt;br/&gt;• parts are joined on the way out: one document, one size, seekable end to end&lt;br/&gt;• each part is one ordinary write, so both storage providers stay equal" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="760" width="620" height="250" as="geometry"/></mxCell>
        <mxCell id="p3n4" value="&lt;b&gt;Why the decode leaves the pod, and how far it has&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Measured:&lt;/i&gt; every stream decodes keyframes and JPEG-encodes a preview whether or not anybody is looking, which costs &lt;b&gt;about a fifth of the pod&lt;/b&gt; &amp;#8212; 0.7 of a core at 100 streams, 0.9 at 150. Real, but not the dominant cost: two threads per stream, the demultiplexer and libsrt&#x27;s own, are twice that.&lt;br/&gt;&lt;br/&gt;The answer is to decode &lt;b&gt;once, somewhere else&lt;/b&gt;. The worker now does, for detection, and &lt;b&gt;only at the detection rate&lt;/b&gt;: at one a second on a twenty-five frame stream that is one decode in twenty-five, keyframes when the rate allows, the tracker predicting between. &lt;i&gt;Measured:&lt;/i&gt; RF-DETR Nano costs about &lt;b&gt;540 ms a frame&lt;/b&gt; on this processor, so the model, not the decode, is the worker&#x27;s budget. The preview becoming a by-product of that decode is the part still planned.&lt;br/&gt;&lt;br/&gt;The two also scale differently: ingest is bounded by libsrt&#x27;s receive thread, one per bound ingest port, detection by the model, and by a GPU when there is one." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="1030" width="620" height="210" as="geometry"/></mxCell>
        <mxCell id="p3n5" value="&lt;b&gt;KLV costs nothing, and is not detection&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;MISB metadata rides as its own elementary stream on its own stream index. Extracting it is reading packets from that index and &lt;b&gt;never touching a decoder&lt;/b&gt; &amp;#8212; a packet subscriber, exactly like the recorder and the viewer.&lt;br/&gt;&lt;br/&gt;At a thousand streams that is close to free, and it must never be allowed to argue for decoding anything.&lt;br/&gt;&lt;br/&gt;The worker takes both indexes off the same transport today. Geo-referencing a detection from a moving platform, position and sensor pointing from MISB 0601 aligned to the frame by presentation timestamp, is planned on top of that. Detections themselves leave as ST 0903 VMTI, standalone: never burned into the picture and never nested in the platform metadata, a second stream on the same clock beside the KLV ring." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="760" width="480" height="280" as="geometry"/></mxCell>
        <mxCell id="p3lg" value="Built, and planned" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1380" y="1060" width="480" height="200" as="geometry"/></mxCell>
        <mxCell id="p3lb1" value="Built" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1405" y="1105" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="p3lp1" value="Planned" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1625" y="1105" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="p3lt1" value="Dashed and grey is planned, not built. The decoder and the harvester are drawn that way because their &lt;i&gt;removal&lt;/i&gt; is planned: today they still run in this pod, for the preview, while detection&#x27;s decode already runs in the worker. Also planned: the GPU, the preview as the worker&#x27;s by-product, VMTI muxed into the SRT output." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1405" y="1155" width="430" height="95" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="3-scaling-in-kubernetes" name="3. Scaling in Kubernetes">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1580" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4t1" value="What makes this scale in Kubernetes &amp;#8212; and what does not" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="p4t2" value="Two media Services, one Deployment, and a shared registry holding the claim. Whatever needs the bytes is forwarded to the replica that owns the name. A second Deployment of workers takes streams by lease and scales on its own." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="p4svcin" value="&lt;b&gt;Ingest Service&lt;/b&gt;&lt;br/&gt;LoadBalancer, UDP 9000 and up" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="p4svccon" value="&lt;b&gt;Consumption Service&lt;/b&gt;&lt;br/&gt;LoadBalancer, UDP 9010" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="p4gdep" value="Deployment &amp;#8212; replicas, no pod identity" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="720" height="170" as="geometry"/></mxCell>
        <mxCell id="p4pa" value="replica A&lt;br/&gt;owns camera-1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="360" y="160" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="p4pb" value="replica B&lt;br/&gt;owns nothing yet" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="600" y="160" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="p4pc" value="replica C" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="840" y="160" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="p4redis" value="&lt;b&gt;Shared registry&lt;/b&gt; &amp;#8212; the claim&lt;br/&gt;name &amp;#8594; owner and pod IP, heartbeat&lt;br/&gt;a lock serialises a claim, and a live name is held" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="p4srcstore" value="&lt;b&gt;Shared source store&lt;/b&gt; &amp;#8212; configuration, not a reading&lt;br/&gt;pull sources and forwards an operator set up; outlives a stream ending, a pod dying, a restart" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="p4e7" value="every beat, picks up any unclaimed pull source under the same lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4pb" target="p4srcstore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4lg" value="Built, and planned" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="690" y="330" width="470" height="175" as="geometry"/></mxCell>
        <mxCell id="p4lb1" value="Built" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="380" width="150" height="45" as="geometry"/></mxCell>
        <mxCell id="p4lp1" value="Planned" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="380" width="150" height="45" as="geometry"/></mxCell>
        <mxCell id="p4lt1" value="Dashed and grey is planned, not built. Built: the listener and its handshake gate, the name lock, multi-port ingest, the HTTP hop between pods, a full pod refusing a caller, leases for pulled streams, the shared source store, and the worker Deployment and its lease. Planned: the ingest and consumption passphrase, GPU nodes for the workers." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="430" width="430" height="70" as="geometry"/></mxCell>
        <mxCell id="p4gwk" value="Worker Deployment &amp;#8212; built. Processor nodes today, scaled on its own" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="660" height="380" as="geometry"/></mxCell>
        <mxCell id="p4wk1" value="worker 1&lt;br/&gt;holds streams by lease, decodes at the detection rate" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1210" y="160" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="p4wk2" value="worker 2&lt;br/&gt;added freely; a stream moves to whoever claims it next" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1530" y="160" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="p4wgpu" value="GPU nodes &amp;#8212; nvidia.com/gpu: 1, a CUDA base image, the provider picked up at load; nothing else changes" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1210" y="245" width="600" height="45" as="geometry"/></mxCell>
        <mxCell id="p4wt" value="Every beat a worker lists the streams, claims any whose toggle is on and no worker holds by writing its name through the owner, and renews by the same call; a holder silent for five beats loses it. &lt;b&gt;Nothing pushes work to a worker&lt;/b&gt;, so replicas here are added, removed and replaced without touching the ingest tier, and a stream moves to whichever worker claims it next. It subscribes over HTTP from whichever replica owns the stream and posts VMTI back the same way.&lt;br/&gt;&lt;br/&gt;It is a separate Deployment and a separate autoscaler because the two tiers are bounded by different things: &lt;b&gt;ingest by libsrt&#x27;s receive thread, one per bound ingest port&lt;/b&gt;, &lt;b&gt;detection by the model&lt;/b&gt; &amp;#8212; &lt;i&gt;measured&lt;/i&gt; at about 540 ms a frame for RF-DETR Nano on a processor, one replica until a GPU exists. Tying them together would mean buying a GPU for every ingest replica.&lt;br/&gt;&lt;br/&gt;The cost is that every detected stream leaves its ingest pod a second time." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="300" width="600" height="180" as="geometry"/></mxCell>
        <mxCell id="p4e1" value="an encoder lands anywhere" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p4svcin" target="p4pa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4e2" value="a viewer lands anywhere" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4svccon" target="p4pb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="320"/><mxPoint x="290" y="195"/></Array></mxGeometry></mxCell>
        <mxCell id="p4e3" value="forwarded to the owner" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4pb" target="p4pa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="265"/><mxPoint x="460" y="265"/></Array></mxGeometry></mxCell>
        <mxCell id="p4e4" value="claims the name under the lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#9673a6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4pa" target="p4redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="195"/><mxPoint x="310" y="415"/></Array></mxGeometry></mxCell>
        <mxCell id="p4e5" value="looks the owner up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="p4pb" target="p4redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4e6" value="claims by lease, subscribes,&lt;br/&gt;posts VMTI back &amp;#8212; HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4wk1" target="p4pc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4n1" value="&lt;b&gt;1. Nothing points at a particular pod&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A replica claims a stream&#x27;s name when the handshake admits it and &lt;b&gt;records its own pod IP&lt;/b&gt; in the shared registry. A replica needing to reach it looks the address up rather than deriving it from a predictable name.&lt;br/&gt;&lt;br/&gt;So: a &lt;b&gt;Deployment&lt;/b&gt;, not a StatefulSet. No headless Service, no per-pod ingest Services, no ordinal names. All of that existed only so a sender could be aimed at one pod, and nothing aims at a pod any more." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="p4n2" value="&lt;b&gt;2. Per-flow stickiness yes, session affinity no&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;An SRT connection is a UDP flow, so &lt;b&gt;its packets must all reach the same pod&lt;/b&gt;. That is ordinary connection tracking, and every load balancer in play does it without being configured to.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Stickiness across reconnects is not required.&lt;/b&gt; A returning encoder may land anywhere, and the name decides what happens next: while that name is still live and held it is &lt;b&gt;refused at the handshake&lt;/b&gt; and the encoder retries. A retry comes from a fresh source port and is re-balanced, so it lands elsewhere.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;sessionAffinity stays None.&lt;/b&gt; ClientIP applies to UDP and would pin a retry back to the pod that refused it." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="520" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="p4n3" value="&lt;b&gt;3. Capacity is a joint budget, not a stream count&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Measured on one container, &lt;b&gt;one ingest port&lt;/b&gt;:&lt;/i&gt; the receive thread&#x27;s knee is around &lt;b&gt;sixty camera-rate streams&lt;/b&gt; per pod at four megabits, about 150 at half a megabit, under twenty at fifteen. Sockets and packet rate buy from the same budget, so neither figure alone sizes a pod.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Two to four ingest ports roughly double it.&lt;/b&gt; Four took the camera-rate knee from 80 streams to 125 on the same machine, for about a third more processor and memory per stream. Plan on about two, not four.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Memory follows bitrate&lt;/b&gt;, not the buffer ceiling: roughly two to two and a half times the buffer window times the wire rate.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Accept rate is no longer on this list.&lt;/b&gt; It used to be two or three a second per port and it is not a ceiling any more." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="520" width="560" height="280" as="geometry"/></mxCell>
        <mxCell id="p4n4" value="&lt;b&gt;4. Readiness is about the media ports&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Storage and a database being reachable say nothing about whether an encoder aimed at this pod will get a stream. A replica that is reachable but &lt;b&gt;not accepting&lt;/b&gt; is worse than one plainly absent: the Service keeps sending encoders to it and they keep failing.&lt;br/&gt;&lt;br/&gt;Readiness is now a &lt;b&gt;fact rather than a timing heuristic&lt;/b&gt;. The bind and the listen either succeed or return an error, and a replica whose libsrt is missing or too old takes itself &lt;b&gt;out of the Service&lt;/b&gt;.&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Accepted consequence: readiness gates the pod and the pod backs all three Services, so a storage outage also removes it from ingest. Kubernetes has no per-port readiness.&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="p4n5" value="&lt;b&gt;5. Always leave somewhere to land&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;maxUnavailable: 0&lt;/b&gt; &amp;#8212; a replica is never taken away before its replacement is serving&lt;br/&gt;• &lt;b&gt;PodDisruptionBudget minAvailable: 1&lt;/b&gt; &amp;#8212; a node drain says the same&lt;br/&gt;• &lt;b&gt;preStop: sleep 5&lt;/b&gt; &amp;#8212; kube-proxy stops routing before sockets close, so a reconnect does not land back on the pod that is leaving&lt;br/&gt;• &lt;b&gt;terminationGracePeriodSeconds: 60&lt;/b&gt; &amp;#8212; a recording in progress finishes uploading its part&lt;br/&gt;• &lt;b&gt;startupProbe&lt;/b&gt; &amp;#8212; a slow start is not mistaken for a failure" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="830" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="p4n6" value="&lt;b&gt;6. What a replica disappearing actually costs&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Deleted gracefully&lt;/b&gt; &amp;#8212; producer ~1&amp;#8211;2 s, viewer ~1.5 s, no player reconnect.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Force-killed&lt;/b&gt; &amp;#8212; producer ~7 s, viewer ~9 s, still no player reconnect. Six of those seconds are the encoder waiting out &lt;i&gt;its own&lt;/i&gt; SRT peer timeout.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;A dead pod holds its names for about six seconds&lt;/b&gt;, three missed heartbeats, and not for the full grace period. An encoder arriving inside that window is refused and retries.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;A viewer&#x27;s connection survives its stream moving.&lt;/b&gt; The replica holding it re-resolves the owner and re-attaches inside the same socket.&lt;br/&gt;&lt;br/&gt;Measured rather than estimated: &lt;b&gt;docs/replica-failover.md&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="830" width="560" height="300" as="geometry"/></mxCell>
        <mxCell id="p4n7" value="&lt;b&gt;7. What does NOT scale this way&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Everyone watching a given stream funnels through that stream&#x27;s owner&lt;/b&gt;, because only the owner holds the bytes. Spreading streams across replicas does nothing for a single popular stream, and the owner&#x27;s egress is the ceiling.&lt;br/&gt;&lt;br/&gt;That is correct for contribution, where cameras outnumber viewers, and it is the wrong shape for distributing one stream to an audience. If that is ever needed the answer is an edge tier or a segmented format in front of the consumption port, not more replicas.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;A recording still dies with its pod&lt;/b&gt;, apart from the parts already uploaded. Moving a running recording between replicas is deliberately deferred." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="540" height="320" as="geometry"/></mxCell>
        <mxCell id="p4n8" value="&lt;b&gt;8. One receive thread per bound port, and a silent ceiling&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;libsrt runs &lt;b&gt;one receive thread per bound UDP port&lt;/b&gt;, and every socket accepted on a port shares it. One port is a single-core ceiling, and it is half the reason the worker tier is a separate Deployment.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ingest can bind several.&lt;/b&gt; &lt;b&gt;Live__IngestPortCount&lt;/b&gt; binds that many consecutive ports and gets a receive thread each, evenly loaded. The default is one, and raising it is only worth anything if the Service publishes the whole range and encoders are spread across it. &lt;i&gt;Measured:&lt;/i&gt; about twice the streams, not four times, for about a third more processor and memory per stream.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Overload is silent.&lt;/b&gt; Measured at 250 low-bitrate streams, the API reported 250 contented live streams while the service was demultiplexing a fifth of the media being sent. A gauge of streams owned would have read full health at the moment every stream was broken, so delivered bitrate is the honest signal and the autoscaler is not trustworthy without it.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;No longer a limit:&lt;/b&gt; the name used to arrive only after accept, so nothing could be refused by name. The handshake now answers first." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="1140" width="540" height="320" as="geometry"/></mxCell>
        <mxCell id="p4n9" value="&lt;b&gt;9. The in-cluster hop, and the tier that waits on it&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A viewer landing on a pod that does not own the stream is served from the owner. The hop is an &lt;b&gt;ordinary HTTP request between pods&lt;/b&gt;, &lt;b&gt;GET /api/live/peer/view/{name}&lt;/b&gt;, and the receiving pod copies that body into the viewer&#x27;s SRT socket. SRT still reaches the viewer; only the hop between two pods changed.&lt;br/&gt;&lt;br/&gt;It replaced a second SRT dial into the owner&#x27;s consumption port, which paid a second handshake, a second latency window and a second libav probe.&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Measured on two pods:&lt;/i&gt; a join costs &lt;b&gt;1.93 s on the owner against 1.81 s relayed&lt;/b&gt; &amp;#8212; the same number inside this rig&#x27;s noise, where the SRT relay cost 1.78 s against 3.76 s. &lt;b&gt;The penalty is gone rather than reduced.&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The same route is what a worker subscribes through, and the hop it posts VMTI frames back on. The worker tier is built on it." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="1140" width="560" height="320" as="geometry"/></mxCell>
        <mxCell id="p4t3" value="Ingest and consumption are separate Services so each can be exposed to a different network, with its own type, annotations and source ranges. That separation is the entire reason for the split." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1490" width="1700" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
