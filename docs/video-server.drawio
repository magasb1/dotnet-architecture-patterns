<mxfile host="app.diagrams.net" agent="storage-demo" version="24.7.17" type="device">
  <diagram id="step-by-step" name="Step by step">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="How it works, one step at a time" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="t3" value="Two addresses and a name. Everything else follows from those three things." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="g4" value="A camera goes on air" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="540" height="690" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;1 &amp;#8194;The camera connects and says its name&lt;/b&gt;&lt;br/&gt;One address, the same one forever. Nobody set anything up beforehand &amp;#8212; the camera just starts talking." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="65" y="160" width="490" height="105" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;2 &amp;#8194;Whichever machine answers keeps it&lt;/b&gt;&lt;br/&gt;It writes down &amp;#8220;this stream is mine&amp;#8221; where the other machines can see it, along with how to reach it." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="65" y="300" width="490" height="105" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;3 &amp;#8194;The video flows into a buffer&lt;/b&gt;&lt;br/&gt;The last thirty seconds are always kept in memory, whether or not anyone is watching or recording." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="65" y="440" width="490" height="105" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;4 &amp;#8194;A picture is decoded for the tile&lt;/b&gt;&lt;br/&gt;Once every couple of seconds, so the list of cameras shows what each one is looking at right now." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="65" y="580" width="490" height="105" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g12" value="Watching and recording" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="540" height="690" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;5 &amp;#8194;Someone watches&lt;/b&gt;&lt;br/&gt;They connect to the other address and name the camera they want. Any machine answers; it fetches from whichever one holds the stream." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="645" y="160" width="490" height="105" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;6 &amp;#8194;Someone presses record&lt;/b&gt;&lt;br/&gt;It reaches back into that buffer, so the recording starts about five seconds &lt;i&gt;before&lt;/i&gt; the button was pressed." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="645" y="300" width="490" height="105" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b&gt;7 &amp;#8194;Every few minutes a piece is filed away&lt;/b&gt;&lt;br/&gt;Written to disk, uploaded, deleted. A six hour recording never sits on one machine &amp;#8212; only the few minutes in progress do." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="645" y="440" width="490" height="105" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;8 &amp;#8194;You see one file&lt;/b&gt;&lt;br/&gt;One name, one size, one download. The pieces are joined on the way out, and you can jump to any point in it." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="645" y="580" width="490" height="105" as="geometry"/></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g20" value="When a machine disappears" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b&gt;9 &amp;#8194;The camera notices and redials&lt;/b&gt;&lt;br/&gt;Same address as always. It does not need to know that anything happened, and nobody has to reconfigure it." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1225" y="160" width="470" height="105" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;10 &amp;#8194;Another machine answers and claims the name&lt;/b&gt;&lt;br/&gt;Because the name is the identity, this is the &lt;i&gt;same&lt;/i&gt; stream carrying on &amp;#8212; not a second one that happens to look like it." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1225" y="300" width="470" height="105" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b&gt;11 &amp;#8194;Anyone watching keeps watching&lt;/b&gt;&lt;br/&gt;Their connection is held open and quietly re-pointed at wherever the stream went. They see a gap in the picture, not a disconnection." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1225" y="440" width="470" height="105" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b&gt;12 &amp;#8194;What was already recorded is safe&lt;/b&gt;&lt;br/&gt;Everything filed away in step 7 is already stored. At worst the few minutes in progress are lost." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#b0b7c3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1225" y="580" width="470" height="105" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#b0b7c3;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#b0b7c3;" edge="1" parent="1" source="c16" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t30" value="Nothing ever points at a particular machine. That one rule is what lets machines be added, removed and replaced without touching a single camera or player." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1660" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="1-the-shape" name="1. The shape">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="Video server — three ports, any replica, one name per stream" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="t3" value="An encoder connects and names itself in the SRT stream identifier. Nothing is requested first. The replica that accepts it owns that stream until a newer connection takes the name." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="g4" value="Cameras" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="290" as="geometry"/></mxCell>
        <mxCell id="c5" value="Encoder 1&lt;br/&gt;SRT caller" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="c6" value="Encoder 2&lt;br/&gt;SRT caller" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="c7" value="Encoder 3&lt;br/&gt;SRT caller" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;Ingest Service&lt;/b&gt;&lt;br/&gt;LoadBalancer, UDP 9000&lt;br/&gt;externalTrafficPolicy: Local" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="205" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="g9" value="Deployment — replicas, no pod identity" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="550" y="110" width="660" height="620" as="geometry"/></mxCell>
        <mxCell id="g10" value="Replica A — owns camera-1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="575" y="150" width="610" height="250" as="geometry"/></mxCell>
        <mxCell id="c11" value="accept&lt;br/&gt;carousel" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="595" y="195" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="c12" value="hub&lt;br/&gt;+ buffer" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="770" y="195" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="c13" value="recorder" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="945" y="180" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="c14" value="harvester → preview" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="945" y="225" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="c15" value="viewer out" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="770" y="310" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="e16" value="packets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g20" value="Replica B — owns nothing yet" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="575" y="440" width="610" height="250" as="geometry"/></mxCell>
        <mxCell id="c21" value="accept&lt;br/&gt;carousel" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="595" y="485" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="c22" value="hub&lt;br/&gt;+ buffer" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="770" y="485" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="c23" value="relays a viewer&lt;br/&gt;to the owner" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="945" y="480" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;API Service&lt;/b&gt;&lt;br/&gt;REST 8080, gRPC 5080&lt;br/&gt;documents and control" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1280" y="150" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;Consumption Service&lt;/b&gt;&lt;br/&gt;LoadBalancer, UDP 9010&lt;br/&gt;externalTrafficPolicy: Local" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1280" y="310" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="c27" value="Desktop client&lt;br/&gt;gRPC" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1560" y="150" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="c28" value="Players&lt;br/&gt;SRT caller&lt;br/&gt;ffplay, desktop client" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1560" y="310" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br/&gt;registry: name → owner, heartbeat&lt;br/&gt;lock: serialises a claim" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="575" y="790" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;b&gt;Object storage&lt;/b&gt; — S3 or filesystem&lt;br/&gt;recordings/{id}/00000.ts … parts&lt;br/&gt;documents/   thumbnails/" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="895" y="790" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b&gt;Database&lt;/b&gt;&lt;br/&gt;one row per document,&lt;br/&gt;carrying its part list" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1235" y="790" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e35" value="the load balancer picks a pod" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c8" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c28" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e38" value="lands anywhere" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c26" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e39" value="relay over SRT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c23" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c27" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e41" value="any replica answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c25" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e42" value="forwarded over HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c22" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e43" value="claims the name,&lt;br/&gt;records its own pod IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="c12" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="c22" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" value="parts, as they complete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="c13" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e46" value="one document" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="c13" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n47" value="&lt;b&gt;Why this shape&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;One address per purpose.&lt;/b&gt; Reaching ingest lets you push a stream and nothing else; reaching consumption lets you watch and nothing else. That is what keeps the firewall statement to one sentence per port.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;The name is the identity.&lt;/b&gt; The registry is keyed by name, so a camera that drops and reconnects resumes the same stream rather than creating a second one.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;The newest connection wins.&lt;/b&gt; A replica finding the name already held takes it anyway; the previous owner learns on its next heartbeat and stands down. Recovery never waits on a socket that has not yet noticed its peer is gone." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="470" height="270" as="geometry"/></mxCell>
        <mxCell id="n48" value="&lt;b&gt;Only the owner has the bytes&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A stream&#x27;s packets exist on exactly one replica. Everything else is routed to it:&lt;br/&gt;&lt;br/&gt;• a control call reaching another replica is &lt;b&gt;forwarded over HTTP&lt;/b&gt;&lt;br/&gt;• a viewer landing on another replica is &lt;b&gt;relayed over SRT&lt;/b&gt;, because SRT has no redirect&lt;br/&gt;&lt;br/&gt;So a caller never has to know which pod took the stream, and nothing points at a particular pod. That is what allows a Deployment rather than a StatefulSet." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="470" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="2-inside-one-replica" name="2. Inside one replica">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="Inside one replica — one demultiplexer, one hub, two tiers" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="t3" value="Packets flow one way. Consumers attach and detach; the harvester is always attached. A stream nobody is watching costs a buffer and almost nothing else." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="SRT accept carousel&lt;br/&gt;re-opens after&lt;br/&gt;every accept" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="c5" value="demultiplexer&lt;br/&gt;one per stream" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="280" y="150" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;hub&lt;/b&gt;&lt;br/&gt;the fan-out point" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="500" y="145" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;rolling buffer&lt;/b&gt;&lt;br/&gt;held as segments&lt;br/&gt;30 s or a byte ceiling,&lt;br/&gt;whichever binds first" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="490" y="255" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="e8" value="accepted socket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="packets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="always buffering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g11" value="Packet tier — no decoding anywhere near it" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="750" y="115" width="510" height="255" as="geometry"/></mxCell>
        <mxCell id="c12" value="recorder&lt;br/&gt;parts → object storage" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="775" y="160" width="215" height="60" as="geometry"/></mxCell>
        <mxCell id="c13" value="viewer&lt;br/&gt;its own muxer → SRT" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="775" y="240" width="215" height="60" as="geometry"/></mxCell>
        <mxCell id="c14" value="KLV extractor&lt;br/&gt;a subscriber on&lt;br/&gt;another stream index" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1020" y="200" width="215" height="60" as="geometry"/></mxCell>
        <mxCell id="g15" value="Frame tier — one decode, however many want pictures" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="750" y="400" width="510" height="210" as="geometry"/></mxCell>
        <mxCell id="c16" value="decoder&lt;br/&gt;keyframes only today" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="775" y="445" width="215" height="60" as="geometry"/></mxCell>
        <mxCell id="c17" value="harvester&lt;br/&gt;the picture now" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1020" y="445" width="215" height="60" as="geometry"/></mxCell>
        <mxCell id="c18" value="detection or tracking would raise the decode rate by asking for it" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="775" y="525" width="460" height="55" as="geometry"/></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;" edge="1" parent="1" source="c6" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e22" value="itself a packet subscriber" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="frames" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c24" value="object storage" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1330" y="160" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="c25" value="consumption port" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1330" y="240" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="c26" value="preview JPEG" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1330" y="445" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c17" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n30" value="&lt;b&gt;The buffer answers three questions with one mechanism&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;It is held as &lt;b&gt;segments&lt;/b&gt;, each beginning where a decoder can start. So:&lt;br/&gt;&lt;br/&gt;• a viewer &lt;b&gt;joins&lt;/b&gt; at a segment&lt;br/&gt;• a viewer &lt;b&gt;rolls back&lt;/b&gt; to a segment&lt;br/&gt;• a recording&#x27;s &lt;b&gt;pre-roll&lt;/b&gt; is cut at a segment&lt;br/&gt;&lt;br/&gt;All three are “choose a segment”, and eviction is “drop the oldest”. The cost is granularity and it is the sender&#x27;s to control: a segment is its keyframe interval, so the window promise is &lt;i&gt;at least&lt;/i&gt; the seconds asked for, never exactly." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="620" height="250" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;Backpressure means different things&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Every subscriber has a bounded queue. An unbounded one turns a slow viewer into a memory leak, and blocking turns one into a stall on ingest.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;A viewer that falls behind skips forward to live.&lt;/b&gt; Unintended lag is a fault; only a deliberate rollback is a chosen position.&lt;br/&gt;• &lt;b&gt;A recorder that overflows stops&lt;/b&gt; and marks its document truncated. Dropping packets would write a hole into a file that claims to be a recording." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="620" height="210" as="geometry"/></mxCell>
        <mxCell id="n32" value="&lt;b&gt;A recording is written in parts&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A camera recording for six hours cannot wait until it ends to be stored. A few minutes are muxed to local disk, uploaded as an ordinary object, and the local file deleted.&lt;br/&gt;&lt;br/&gt;• disk and memory bounded by &lt;b&gt;one part&lt;/b&gt;, whatever the total length&lt;br/&gt;• a pod that dies loses &lt;b&gt;at most the part in progress&lt;/b&gt;&lt;br/&gt;• parts are joined on the way out: one document, one size, seekable end to end&lt;br/&gt;• each part is one ordinary write, so both storage providers stay equal" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="700" width="620" height="210" as="geometry"/></mxCell>
        <mxCell id="n33" value="&lt;b&gt;The seam&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The two tiers are where detection, tracking and KLV extraction attach later.&lt;br/&gt;&lt;br/&gt;Nothing more needs to exist now. A consumer that only moves bytes never pays for a decode, and a detector raises the decode rate by asking for it rather than getting it by default." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="560" width="370" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="3-scaling-in-kubernetes" name="3. Scaling in Kubernetes">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="What makes this scale in Kubernetes — and what does not" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;1. Nothing points at a particular pod&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A replica claims a stream&#x27;s name when the connection arrives and &lt;b&gt;records its own pod IP&lt;/b&gt; in the shared registry. A replica needing to reach it looks the address up rather than deriving it from a predictable name.&lt;br/&gt;&lt;br/&gt;So: a &lt;b&gt;Deployment&lt;/b&gt;, not a StatefulSet. No headless Service, no per-pod ingest Services, no ordinal names. All of that existed only so a sender could be aimed at one pod, and nothing aims at a pod any more." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="540" height="250" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;2. Per-flow stickiness yes, session affinity no&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;An SRT connection is a UDP flow, so &lt;b&gt;its packets must all reach the same pod&lt;/b&gt;. That is ordinary connection tracking, and every load balancer in play does it without being configured to.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Stickiness across reconnects is not required.&lt;/b&gt; A returning encoder may land anywhere: the newest connection wins the name and the previous owner stands down. No affinity configuration, no session tables, nothing to get wrong." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="540" height="250" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;3. Capacity is calculable, so the request is honest&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Memory&lt;/b&gt; = per-stream buffer ceiling × streams owned&lt;br/&gt;• &lt;b&gt;Ephemeral disk&lt;/b&gt; = one recording part × concurrent recordings&lt;br/&gt;• &lt;b&gt;Accept rate&lt;/b&gt; ≈ 2–3 connections a second, per port, per replica&lt;br/&gt;&lt;br/&gt;The useful autoscaling signal is therefore &lt;b&gt;streams owned per replica&lt;/b&gt;, not processor load: an idle stream still costs a buffer and almost no CPU." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="70" width="560" height="250" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;4. Readiness is about the media ports&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Storage and a database being reachable say nothing about whether an encoder aimed at this pod will get a stream. A replica that is reachable but &lt;b&gt;not accepting&lt;/b&gt; is worse than one plainly absent: the Service keeps sending encoders to it and they keep failing.&lt;br/&gt;&lt;br/&gt;So readiness includes both carousels, and a failed stream-identifier self-test or an FFmpeg without SRT takes the replica &lt;b&gt;out of the Service&lt;/b&gt;.&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Accepted consequence: readiness gates the pod and the pod backs all three Services, so a storage outage also removes it from ingest. Kubernetes has no per-port readiness.&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;5. Always leave somewhere to land&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;maxUnavailable: 0&lt;/b&gt; — a replica is never taken away before its replacement is serving&lt;br/&gt;• &lt;b&gt;PodDisruptionBudget minAvailable: 1&lt;/b&gt; — a node drain says the same&lt;br/&gt;• &lt;b&gt;preStop: sleep 5&lt;/b&gt; — kube-proxy stops routing before sockets close, so a reconnect does not land back on the pod that is leaving&lt;br/&gt;• &lt;b&gt;terminationGracePeriodSeconds: 60&lt;/b&gt; — a recording in progress finishes uploading its part&lt;br/&gt;• &lt;b&gt;startupProbe&lt;/b&gt; — the boot self-test is not mistaken for a failure" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="350" width="540" height="280" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;6. What a replica disappearing actually costs&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Deleted gracefully&lt;/b&gt; — producer ~1–2 s, viewer ~1.5 s, no player reconnect.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Force-killed&lt;/b&gt; — producer ~7 s, viewer ~9 s, still no player reconnect. Six of those seconds are the encoder waiting out &lt;i&gt;its own&lt;/i&gt; SRT peer timeout, which is the encoder&#x27;s setting rather than the service&#x27;s.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;A viewer&#x27;s connection survives its stream moving.&lt;/b&gt; The replica holding it re-resolves the owner and re-attaches inside the same socket, carrying the timeline across.&lt;br/&gt;&lt;br/&gt;Measured rather than estimated: &lt;b&gt;docs/replica-failover.md&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="350" width="560" height="280" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;7. What does NOT scale this way&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Everyone watching a given stream funnels through that stream&#x27;s owner&lt;/b&gt;, because only the owner holds the bytes. Spreading streams across replicas does nothing for a single popular stream, and the owner&#x27;s egress is the ceiling.&lt;br/&gt;&lt;br/&gt;That is correct for contribution, where cameras outnumber viewers, and it is the wrong shape for distributing one stream to an audience. If that is ever needed the answer is an edge tier or a segmented format in front of the consumption port, not more replicas.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;A recording still dies with its pod&lt;/b&gt;, apart from the parts already uploaded. Moving a running recording between replicas is deliberately deferred." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="850" height="250" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;8. Two inherent limits of the accept path&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A libav SRT listener accepts exactly one caller and then closes its own listening socket, so concurrency comes from &lt;b&gt;re-opening the listener after every accept&lt;/b&gt;. Both media ports run one of these carousels.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;The backlog is one&lt;/b&gt;, giving roughly two or three accepts a second per port. Senders and players must retry, which encoders do by nature, and adding replicas adds accept capacity linearly.&lt;br/&gt;• &lt;b&gt;The name arrives after accept, never before.&lt;/b&gt; Nothing can be refused by name, only accepted and then dropped. That is why an SRT passphrase is the stronger authentication candidate: it acts during the handshake." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="660" width="830" height="250" as="geometry"/></mxCell>
        <mxCell id="t11" value="Ingest and consumption are separate Services so each can be exposed to a different network, with its own type, annotations and source ranges. That separation is the entire reason for the split." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1700" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
