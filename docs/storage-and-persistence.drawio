<mxfile host="app.diagrams.net" agent="storage-demo" version="24.7.17" type="device">
  <diagram id="1-two-concerns-not-one" name="1. Two concerns, not one">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="Storage and persistence are two independent concerns" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="t3" value="Nothing in domain or application code knows which implementation is running. One file decides, from three switches that are set independently of each other." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="g4" value="The interface this deliberately is not" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="620" height="330" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;IStorageProvider&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;SaveFile()&lt;br/&gt;SaveEntity()&lt;br/&gt;DeleteEntity()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="70" y="155" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="t6" value="One interface over two unrelated things. Every implementation then has to answer for both, so a filesystem grows a database and a database grows a blob column, and the combination you actually want becomes the one nobody wrote." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="325" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="g7" value="What it is instead" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="1060" height="330" as="geometry"/></mxCell>
        <mxCell id="c8" value="API&lt;br/&gt;REST and gRPC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="760" y="155" width="180" height="45" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;DocumentService&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="155" width="220" height="45" as="geometry"/></mxCell>
        <mxCell id="c10" value="IFileStorage" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1310" y="140" width="200" height="35" as="geometry"/></mxCell>
        <mxCell id="c11" value="IDocumentRepository" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1310" y="185" width="200" height="35" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t15" value="The service coordinates the two. They share no transaction, so a write that half-fails is compensated rather than rolled back: if the row cannot be written, the object it points at is deleted again. The storage monitor is the backstop for everything that gets past that." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="235" width="1000" height="180" as="geometry"/></mxCell>
        <mxCell id="g16" value="A third concern: what has to be shared once there is more than one replica" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1740" height="300" as="geometry"/></mxCell>
        <mxCell id="c17" value="StorageMonitor&lt;br/&gt;scans the store" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="80" y="530" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="c18" value="AnalysisWorker&lt;br/&gt;thumbnails, metadata" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="310" y="530" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="c19" value="LiveStreamCoordinator&lt;br/&gt;owns streams" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="540" y="530" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="c20" value="IChangeFeed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="830" y="520" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="c21" value="IAnalysisQueue" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="830" y="565" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="c22" value="IDistributedLock" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="830" y="610" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="c23" value="ILiveStreamRegistry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="830" y="655" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c17" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t28" value="These four are switched together, because a cluster needs all of them shared or none of them. With the in-process versions and two replicas, each pod would scan the store on its own schedule, a client would only hear about uploads that happened to land on its own pod, and every pod would believe it owned every live stream." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="520" width="650" height="180" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;One file knows&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;DependencyInjection.AddInfrastructure&lt;/b&gt; is the only place a concrete provider is named. Everything else depends on the interface, which is what makes the combination a configuration question rather than a code question." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="850" height="150" as="geometry"/></mxCell>
        <mxCell id="n30" value="&lt;b&gt;And the rule that keeps them equal&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;No feature only one provider has. That is why a long recording is stored as ordinary objects a few minutes at a time rather than streamed in with multipart upload, which S3 has and a filesystem does not." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="820" width="850" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="2-the-implementations" name="2. The implementations">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="Six ports, two implementations each" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="t3" value="Same interface, same behaviour, different machinery. The left column is a laptop with nothing installed; the right is a cluster." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Port&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="270" height="36" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Local &amp;#8212; one process&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="115" width="510" height="36" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Cluster &amp;#8212; many replicas&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="115" width="510" height="36" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Chosen by&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1390" y="115" width="530" height="36" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;IFileStorage&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;FileSystemStorage&lt;/b&gt;&lt;br/&gt;Every key resolves under one root, and anything that escapes it is refused &amp;#8212; including a sibling directory that merely shares its prefix. A ranged read is a seek." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="165" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;S3Storage&lt;/b&gt;&lt;br/&gt;Credentials come from the AWS chain: environment, profile, IRSA, instance role. A ServiceUrl points the same code at MinIO. A ranged read is a Range header." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="165" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;Storage:Provider&lt;/b&gt;&lt;br/&gt;FileSystem &amp;#8901; S3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1390" y="165" width="530" height="130" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;IDocumentRepository&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;LiteDbDocumentRepository&lt;/b&gt;&lt;br/&gt;One file, held open for the life of the process. Direct mode rather than shared: shared takes a cross-process mutex and reopens the file on every call, which measured about four times slower to write." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="310" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;PostgresDocumentRepository&lt;/b&gt;&lt;br/&gt;EF Core. Free-form metadata and a recording&#x27;s part list each go in one jsonb column rather than a table, and the storage key is unique." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="310" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b&gt;Database:Provider&lt;/b&gt;&lt;br/&gt;LiteDb &amp;#8901; Postgres" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1390" y="310" width="530" height="130" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;IChangeFeed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;InMemoryChangeFeed&lt;/b&gt;&lt;br/&gt;A bounded channel per subscriber that drops its oldest event when full, so one stalled client cannot back the monitor up." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="455" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;RedisChangeFeed&lt;/b&gt;&lt;br/&gt;Publish and subscribe on one channel, so every replica&#x27;s clients hear about every replica&#x27;s uploads." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="455" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b&gt;Messaging:Provider&lt;/b&gt;&lt;br/&gt;InMemory &amp;#8901; Redis" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1390" y="455" width="530" height="130" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b&gt;IAnalysisQueue&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b&gt;InMemoryAnalysisQueue&lt;/b&gt;&lt;br/&gt;One unbounded channel with a single reader. Work queued by this process is done by this process." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;RedisAnalysisQueue&lt;/b&gt;&lt;br/&gt;A list, pushed on one end and polled with LPOP from the other. Polled rather than blocked on BLPOP, which would hold a connection open per worker." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="600" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c23" value="the same switch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1390" y="600" width="530" height="130" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b&gt;IDistributedLock&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;InMemoryLock&lt;/b&gt;&lt;br/&gt;Mutual exclusion within one process, which is the whole cluster when there is one. It still refuses a second holder rather than always saying yes." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="745" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;RedisLock&lt;/b&gt;&lt;br/&gt;SET NX PX to take it, and a compare-and-delete script to release it. A plain DEL could remove a lock that had expired and been taken by somebody else." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="745" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c27" value="the same switch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1390" y="745" width="530" height="130" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;ILiveStreamRegistry&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b&gt;InMemoryLiveStreamRegistry&lt;/b&gt;&lt;br/&gt;A dictionary keyed by stream name. One process owns every stream, so it agrees with itself." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="890" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;b&gt;RedisLiveStreamRegistry&lt;/b&gt;&lt;br/&gt;One hash, one field per name. Listing is the common call and a single HGETALL beats scanning a keyspace. The owner field is also the name claim." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="890" width="510" height="130" as="geometry"/></mxCell>
        <mxCell id="c31" value="the same switch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1390" y="890" width="530" height="130" as="geometry"/></mxCell>
        <mxCell id="n32" value="&lt;b&gt;The last four are one decision, not four.&lt;/b&gt; A cluster needs the feed, the queue, the lock and the registry all shared, or none of them: sharing some and not others produces a service that is confidently wrong rather than obviously broken." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1880" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="3-laptop-and-cluster" name="3. Laptop and cluster">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="What actually changes between a laptop and a cluster" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="t3" value="Only configuration. The source is identical in all four." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Scenario&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="210" height="36" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;File storage&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="260" y="115" width="260" height="36" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Database&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="530" y="115" width="240" height="36" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Shared state&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="780" y="115" width="240" height="36" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;What has to persist&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#b0b7c3;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1030" y="115" width="330" height="36" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;A&lt;/b&gt; &amp;#8901; Windows" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="c10" value="Filesystem" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="260" y="165" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="c11" value="LiteDB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="530" y="165" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c12" value="in process" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="780" y="165" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c13" value="a folder on the disk" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="1030" y="165" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;B&lt;/b&gt; &amp;#8901; Linux" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="c15" value="Filesystem" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="260" y="235" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="c16" value="LiteDB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="530" y="235" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c17" value="in process" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="780" y="235" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c18" value="a folder on the disk" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="1030" y="235" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b&gt;C&lt;/b&gt; &amp;#8901; Docker Compose" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="305" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="c20" value="MinIO" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="260" y="305" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="c21" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="530" y="305" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c22" value="Redis" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="780" y="305" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c23" value="container volumes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="1030" y="305" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b&gt;D&lt;/b&gt; &amp;#8901; Kubernetes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="c25" value="AWS S3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="260" y="375" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="c26" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="530" y="375" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c27" value="Redis" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="780" y="375" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c28" value="nothing inside the pod" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0b7c3;" vertex="1" parent="1"><mxGeometry x="1030" y="375" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;Any combination works&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The switches are independent, so Filesystem with PostgreSQL runs, and so does S3 with LiteDB. Neither is a shape anyone deploys, and both being possible is the point: it means no implementation has quietly grown a dependency on its usual partner.&lt;br/&gt;&lt;br/&gt;The four above are the combinations worth running, not the combinations that work." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="115" width="420" height="340" as="geometry"/></mxCell>
        <mxCell id="n30" value="&lt;b&gt;In-memory is not a stub&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The local implementations behave the way the shared ones do rather than doing the easy thing:&lt;br/&gt;&lt;br/&gt;&amp;#8226; the lock &lt;b&gt;refuses&lt;/b&gt; a second holder instead of always granting&lt;br/&gt;&amp;#8226; the registry applies the same staleness rule, so a stream still expires&lt;br/&gt;&amp;#8226; the change feed still drops events for a subscriber that has stopped reading&lt;br/&gt;&lt;br/&gt;So a laptop exercises the behaviour a cluster has, instead of only appearing to." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="880" height="240" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;What in-memory costs in a cluster&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Setting Messaging:Provider to InMemory with more than one replica is the one combination that looks like it works and does not:&lt;br/&gt;&lt;br/&gt;&amp;#8226; every pod scans the store on its own schedule, doing the same work twice&lt;br/&gt;&amp;#8226; a client only hears about uploads that landed on its own pod&lt;br/&gt;&amp;#8226; every pod believes it owns every live stream&lt;br/&gt;&lt;br/&gt;Nothing errors. The answers just depend on which pod you reached." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="470" width="880" height="240" as="geometry"/></mxCell>
        <mxCell id="n32" value="&lt;b&gt;Consistency, since there is no transaction across the two&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Bytes go to storage first, then the row. If the row fails, the object is deleted again &amp;#8212; compensated rather than rolled back. Anything that still gets through, including files added or removed by something other than this application, is picked up by the storage monitor, which reconciles the database against what is actually in the store and treats the store as the truth." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1800" height="130" as="geometry"/></mxCell>
        <mxCell id="t33" value="A recording is the newest thing this has to carry: it is stored as ordinary objects a few minutes at a time, so both providers stay equal, and read back as one document." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1700" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
